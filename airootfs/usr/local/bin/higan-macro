#!/usr/bin/env python3
"""
HiganMacro — High-Performance Game & Roblox Automation Tool
Architecture:
- Native Linux uinput / evdev kernel-level driver (100% Anti-Cheat proof, detected as hardware mouse/keyboard)
- Works under both Wayland and X11
- Compact TinyTask-style floating GTK3 interface with Tech-Noir aesthetic
- Global hotkeys: F8 (Record / Stop Record), F9 (Play / Stop Loop)
"""

import os
import sys
import time
import json
import threading
import select
from pathlib import Path

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib

try:
    import evdev
    from evdev import ecodes
except ImportError:
    print("[!] python-evdev is required. Install with: sudo pacman -S python-evdev")
    sys.exit(1)


# State constants
STATE_IDLE = "IDLE"
STATE_RECORDING = "RECORDING"
STATE_PLAYING = "PLAYING"


class MacroEngine:
    def __init__(self, on_status_change=None, on_event_count=None):
        self.state = STATE_IDLE
        self.recorded_events = []
        self.stop_requested = False
        self.continuous_loop = True
        self.loop_count = 1
        self.speed = 1.0
        self.on_status_change = on_status_change
        self.on_event_count = on_event_count
        self.uinput_device = None
        self.hotkey_thread = None
        self.running_hotkey_listener = True

        self._init_uinput()
        self._start_global_hotkeys()

    def _init_uinput(self):
        try:
            cap = {
                ecodes.EV_KEY: [
                    ecodes.BTN_LEFT, ecodes.BTN_RIGHT, ecodes.BTN_MIDDLE,
                    ecodes.BTN_SIDE, ecodes.BTN_EXTRA
                ] + list(range(1, 256)),
                ecodes.EV_REL: [
                    ecodes.REL_X, ecodes.REL_Y, ecodes.REL_WHEEL, ecodes.REL_HWHEEL
                ],
            }
            self.uinput_device = evdev.UInput(cap, name="Higan-Hardware-Controller")
        except Exception as e:
            print(f"[!] Warning: Failed to create uinput virtual device ({e}). Ensure user is in 'input' and 'uinput' groups.")

    def get_input_devices(self):
        """Scans and returns active physical keyboard and mouse event devices."""
        keyboards = []
        mice = []
        for path in evdev.list_devices():
            try:
                dev = evdev.InputDevice(path)
                caps = dev.capabilities()
                if dev.name == "Higan-Hardware-Controller":
                    continue
                # Check for relative motion (Mouse)
                if ecodes.EV_REL in caps:
                    mice.append(dev)
                # Check for standard alphanumeric keys (Keyboard)
                elif ecodes.EV_KEY in caps:
                    keys = caps[ecodes.EV_KEY]
                    if ecodes.KEY_A in keys or ecodes.KEY_SPACE in keys or ecodes.KEY_ENTER in keys:
                        keyboards.append(dev)
            except Exception:
                pass
        return keyboards, mice

    def _start_global_hotkeys(self):
        """Listens in background for F8 (Record/Stop) and F9 (Play/Stop)."""
        def listener():
            while self.running_hotkey_listener:
                keyboards, _ = self.get_input_devices()
                if not keyboards:
                    time.sleep(1)
                    continue

                fd_map = {kb.fd: kb for kb in keyboards}
                while self.running_hotkey_listener and fd_map:
                    try:
                        r, _, _ = select.select(list(fd_map.keys()), [], [], 0.5)
                        for fd in r:
                            dev = fd_map.get(fd)
                            if not dev:
                                continue
                            for event in dev.read():
                                if event.type == ecodes.EV_KEY and event.value == 1: # Key press
                                    if event.code == ecodes.KEY_F8:
                                        GLib.idle_add(self.toggle_record)
                                    elif event.code == ecodes.KEY_F9:
                                        GLib.idle_add(self.toggle_play)
                    except Exception:
                        break
                time.sleep(0.5)

        self.hotkey_thread = threading.Thread(target=listener, daemon=True)
        self.hotkey_thread.start()

    def toggle_record(self):
        if self.state == STATE_RECORDING:
            self.stop()
        elif self.state == STATE_IDLE:
            self.start_record()

    def toggle_play(self):
        if self.state == STATE_PLAYING:
            self.stop()
        elif self.state == STATE_IDLE:
            self.start_play()

    def start_record(self):
        if self.state != STATE_IDLE:
            return
        self.state = STATE_RECORDING
        self.recorded_events.clear()
        self.stop_requested = False
        if self.on_status_change:
            self.on_status_change(self.state, "RECORDING... [Press F8 to Stop]")

        def record_worker():
            keyboards, mice = self.get_input_devices()
            devices = keyboards + mice
            if not devices:
                GLib.idle_add(self.stop)
                return

            fd_map = {d.fd: d for d in devices}
            start_time = time.perf_counter()
            last_event_time = start_time

            while not self.stop_requested and self.state == STATE_RECORDING:
                try:
                    r, _, _ = select.select(list(fd_map.keys()), [], [], 0.1)
                    for fd in r:
                        dev = fd_map.get(fd)
                        if not dev:
                            continue
                        for event in dev.read():
                            # Filter out non-action SYN events or triggering F8/F9 keys
                            if event.type == ecodes.EV_SYN:
                                continue
                            if event.type == ecodes.EV_KEY and event.code in (ecodes.KEY_F8, ecodes.KEY_F9):
                                continue

                            now = time.perf_counter()
                            delta = now - last_event_time
                            last_event_time = now

                            # Store event: (delta_seconds, type, code, value)
                            self.recorded_events.append((delta, event.type, event.code, event.value))

                            if self.on_event_count:
                                GLib.idle_add(self.on_event_count, len(self.recorded_events), now - start_time)
                except Exception:
                    break

        threading.Thread(target=record_worker, daemon=True).start()

    def start_play(self):
        if self.state != STATE_IDLE or not self.recorded_events:
            return
        if not self.uinput_device:
            self._init_uinput()
            if not self.uinput_device:
                return

        self.state = STATE_PLAYING
        self.stop_requested = False

        def play_worker():
            loop_idx = 1
            while not self.stop_requested:
                status_txt = f"PLAYING (Loop {loop_idx}" + ("/∞)" if self.continuous_loop else f"/{self.loop_count})") + " [F9 to Stop]"
                if self.on_status_change:
                    GLib.idle_add(self.on_status_change, self.state, status_txt)

                for delta, etype, code, val in self.recorded_events:
                    if self.stop_requested:
                        break

                    # Adjust sleep by playback speed
                    sleep_time = delta / max(0.1, self.speed)
                    if sleep_time > 0.0001:
                        time.sleep(sleep_time)

                    try:
                        self.uinput_device.write(etype, code, val)
                        self.uinput_device.syn()
                    except Exception:
                        pass

                if self.stop_requested:
                    break

                if not self.continuous_loop:
                    if loop_idx >= self.loop_count:
                        break

                loop_idx += 1
                time.sleep(0.05) # Small buffer between loops

            # Release any pressed keys on finish
            try:
                for k in range(1, 256):
                    self.uinput_device.write(ecodes.EV_KEY, k, 0)
                self.uinput_device.write(ecodes.EV_KEY, ecodes.BTN_LEFT, 0)
                self.uinput_device.write(ecodes.EV_KEY, ecodes.BTN_RIGHT, 0)
                self.uinput_device.syn()
            except Exception:
                pass

            GLib.idle_add(self.stop)

        threading.Thread(target=play_worker, daemon=True).start()

    def stop(self):
        self.stop_requested = True
        self.state = STATE_IDLE
        if self.on_status_change:
            self.on_status_change(self.state, "IDLE · Ready")

    def save_macro(self, filepath):
        data = {
            "version": "1.0",
            "count": len(self.recorded_events),
            "events": self.recorded_events
        }
        with open(filepath, "w") as f:
            json.dump(data, f)

    def load_macro(self, filepath):
        with open(filepath, "r") as f:
            data = json.load(f)
            self.recorded_events = [tuple(e) for e in data.get("events", [])]
        if self.on_event_count:
            self.on_event_count(len(self.recorded_events), 0)


class HiganMacroWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="HiganMacro — Roblox Automation")
        self.set_default_size(390, 260)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Tech-Noir CSS styling
        self._apply_css()

        # Engine
        self.engine = MacroEngine(
            on_status_change=self.update_status,
            on_event_count=self.update_counter
        )

        self._build_ui()
        self.connect("destroy", self.on_destroy)

    def _apply_css(self):
        css = b"""
        window { background-color: #0b070f; }
        label { color: #f5e6ed; font-family: 'Inter', sans-serif; }
        .title-label { font-size: 13px; font-weight: 800; color: #ffffff; letter-spacing: 0.5px; }
        .sub-label { font-size: 11px; color: #71717a; font-family: monospace; }
        .status-badge { font-family: monospace; font-size: 12px; font-weight: bold; padding: 4px 10px; border-radius: 4px; }
        .badge-idle { background-color: #18101f; color: #a1a1aa; border: 1px solid #27272a; }
        .badge-rec { background-color: #9f1239; color: #ffffff; border: 1px solid #e11d48; }
        .badge-play { background-color: #064e3b; color: #34d399; border: 1px solid #10b981; }
        .btn-rec { background-color: #e11d48; color: #ffffff; font-weight: bold; border-radius: 6px; padding: 6px 14px; border: none; }
        .btn-rec:hover { background-color: #f43f5e; }
        .btn-play { background-color: #059669; color: #ffffff; font-weight: bold; border-radius: 6px; padding: 6px 14px; border: none; }
        .btn-play:hover { background-color: #10b981; }
        .btn-stop { background-color: #27272a; color: #f43f5e; font-weight: bold; border-radius: 6px; padding: 6px 14px; border: 1px solid #3f3f46; }
        .btn-stop:hover { background-color: #3f3f46; }
        .btn-tool { background-color: #18101f; color: #d4d4d8; border-radius: 5px; border: 1px solid #27272a; padding: 4px 8px; font-size: 11px; }
        .btn-tool:hover { border-color: #e11d48; color: #ffffff; }
        entry, spinbutton { background-color: #18101f; color: #ffffff; border: 1px solid #27272a; border-radius: 4px; padding: 3px 6px; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _build_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.set_margin_top(14)
        vbox.set_margin_bottom(14)
        vbox.set_margin_start(16)
        vbox.set_margin_end(16)
        self.add(vbox)

        # Header bar
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(label="HIGANMACRO")
        lbl_title.get_style_context().add_class("title-label")
        lbl_title.set_xalign(0)
        lbl_sub = Gtk.Label(label="Roblox · Linux uinput Hardware Driver")
        lbl_sub.get_style_context().add_class("sub-label")
        lbl_sub.set_xalign(0)
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header.pack_start(title_box, True, True, 0)

        self.chk_ontop = Gtk.CheckButton(label="Stay on Top")
        self.chk_ontop.connect("toggled", self.on_toggle_ontop)
        header.pack_end(self.chk_ontop, False, False, 0)
        vbox.pack_start(header, False, False, 0)

        # Status badge row
        status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.lbl_status = Gtk.Label(label="IDLE · Ready")
        self.lbl_status.get_style_context().add_class("status-badge")
        self.lbl_status.get_style_context().add_class("badge-idle")
        status_box.pack_start(self.lbl_status, True, True, 0)

        self.lbl_counter = Gtk.Label(label="0 events (0.0s)")
        self.lbl_counter.get_style_context().add_class("sub-label")
        status_box.pack_end(self.lbl_counter, False, False, 0)
        vbox.pack_start(status_box, False, False, 0)

        # Main Control Buttons (Record / Play / Stop)
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.btn_rec = Gtk.Button(label="⏺ Record (F8)")
        self.btn_rec.get_style_context().add_class("btn-rec")
        self.btn_rec.connect("clicked", lambda w: self.engine.toggle_record())

        self.btn_play = Gtk.Button(label="▶ Play (F9)")
        self.btn_play.get_style_context().add_class("btn-play")
        self.btn_play.connect("clicked", lambda w: self.engine.toggle_play())

        self.btn_stop = Gtk.Button(label="⏹ Stop")
        self.btn_stop.get_style_context().add_class("btn-stop")
        self.btn_stop.connect("clicked", lambda w: self.engine.stop())

        btn_box.pack_start(self.btn_rec, True, True, 0)
        btn_box.pack_start(self.btn_play, True, True, 0)
        btn_box.pack_start(self.btn_stop, False, False, 0)
        vbox.pack_start(btn_box, False, False, 0)

        # Options Grid
        opt_grid = Gtk.Grid()
        opt_grid.set_column_spacing(10)
        opt_grid.set_row_spacing(6)

        # Continuous Loop
        self.chk_loop = Gtk.CheckButton(label="Infinite Loop (AFK)")
        self.chk_loop.set_active(True)
        self.chk_loop.connect("toggled", self.on_loop_toggled)
        opt_grid.attach(self.chk_loop, 0, 0, 1, 1)

        # Loop count spin
        lbl_reps = Gtk.Label(label="Repeat:")
        lbl_reps.get_style_context().add_class("sub-label")
        self.spin_reps = Gtk.SpinButton.new_with_range(1, 9999, 1)
        self.spin_reps.set_value(1)
        self.spin_reps.set_sensitive(False)
        self.spin_reps.connect("value-changed", self.on_reps_changed)
        opt_grid.attach(lbl_reps, 1, 0, 1, 1)
        opt_grid.attach(self.spin_reps, 2, 0, 1, 1)

        # Speed Multiplier
        lbl_speed = Gtk.Label(label="Speed:")
        lbl_speed.get_style_context().add_class("sub-label")
        self.combo_speed = Gtk.ComboBoxText()
        for s in ["0.5x", "1.0x (Normal)", "1.5x", "2.0x", "5.0x", "10.0x"]:
            self.combo_speed.append_text(s)
        self.combo_speed.set_active(1)
        self.combo_speed.connect("changed", self.on_speed_changed)
        opt_grid.attach(lbl_speed, 0, 1, 1, 1)
        opt_grid.attach(self.combo_speed, 1, 1, 2, 1)

        vbox.pack_start(opt_grid, False, False, 0)

        # Footer Actions (Save / Open / Clear)
        foot_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        btn_save = Gtk.Button(label="💾 Save Macro")
        btn_save.get_style_context().add_class("btn-tool")
        btn_save.connect("clicked", self.on_save_clicked)

        btn_open = Gtk.Button(label="📂 Load Macro")
        btn_open.get_style_context().add_class("btn-tool")
        btn_open.connect("clicked", self.on_open_clicked)

        btn_clear = Gtk.Button(label="🗑 Clear")
        btn_clear.get_style_context().add_class("btn-tool")
        btn_clear.connect("clicked", self.on_clear_clicked)

        foot_box.pack_start(btn_save, True, True, 0)
        foot_box.pack_start(btn_open, True, True, 0)
        foot_box.pack_start(btn_clear, False, False, 0)
        vbox.pack_end(foot_box, False, False, 0)

    def on_toggle_ontop(self, widget):
        self.set_keep_above(widget.get_active())

    def on_loop_toggled(self, widget):
        self.engine.continuous_loop = widget.get_active()
        self.spin_reps.set_sensitive(not widget.get_active())

    def on_reps_changed(self, widget):
        self.engine.loop_count = int(widget.get_value())

    def on_speed_changed(self, widget):
        txt = widget.get_active_text()
        if "0.5x" in txt: self.engine.speed = 0.5
        elif "1.5x" in txt: self.engine.speed = 1.5
        elif "2.0x" in txt: self.engine.speed = 2.0
        elif "5.0x" in txt: self.engine.speed = 5.0
        elif "10.0x" in txt: self.engine.speed = 10.0
        else: self.engine.speed = 1.0

    def update_status(self, state, msg):
        self.lbl_status.set_text(msg)
        ctx = self.lbl_status.get_style_context()
        ctx.remove_class("badge-idle")
        ctx.remove_class("badge-rec")
        ctx.remove_class("badge-play")

        if state == STATE_RECORDING:
            ctx.add_class("badge-rec")
            self.btn_rec.set_label("⏹ Stop Record (F8)")
            self.btn_play.set_sensitive(False)
        elif state == STATE_PLAYING:
            ctx.add_class("badge-play")
            self.btn_play.set_label("⏹ Stop Play (F9)")
            self.btn_rec.set_sensitive(False)
        else:
            ctx.add_class("badge-idle")
            self.btn_rec.set_label("⏺ Record (F8)")
            self.btn_play.set_label("▶ Play (F9)")
            self.btn_rec.set_sensitive(True)
            self.btn_play.set_sensitive(len(self.engine.recorded_events) > 0)

    def update_counter(self, count, duration):
        self.lbl_counter.set_text(f"{count} events ({duration:.1f}s)")
        self.btn_play.set_sensitive(count > 0 and self.engine.state == STATE_IDLE)

    def on_save_clicked(self, widget):
        if not self.engine.recorded_events:
            return
        dialog = Gtk.FileChooserDialog(
            title="Save Macro File",
            parent=self,
            action=Gtk.FileChooserAction.SAVE
        )
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_SAVE, Gtk.ResponseType.ACCEPT)
        dialog.set_current_name("roblox_macro.json")

        filter_json = Gtk.FileFilter()
        filter_json.set_name("Macro JSON (*.json)")
        filter_json.add_pattern("*.json")
        dialog.add_filter(filter_json)

        if dialog.run() == Gtk.ResponseType.ACCEPT:
            filepath = dialog.get_filename()
            if not filepath.endswith(".json"):
                filepath += ".json"
            self.engine.save_macro(filepath)
        dialog.destroy()

    def on_open_clicked(self, widget):
        dialog = Gtk.FileChooserDialog(
            title="Load Macro File",
            parent=self,
            action=Gtk.FileChooserAction.OPEN
        )
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OPEN, Gtk.ResponseType.ACCEPT)

        filter_json = Gtk.FileFilter()
        filter_json.set_name("Macro JSON (*.json)")
        filter_json.add_pattern("*.json")
        dialog.add_filter(filter_json)

        if dialog.run() == Gtk.ResponseType.ACCEPT:
            self.engine.load_macro(dialog.get_filename())
        dialog.destroy()

    def on_clear_clicked(self, widget):
        self.engine.recorded_events.clear()
        self.update_counter(0, 0.0)

    def on_destroy(self, widget):
        self.engine.running_hotkey_listener = False
        self.engine.stop()
        if self.engine.uinput_device:
            self.engine.uinput_device.close()
        Gtk.main_quit()


def main():
    win = HiganMacroWindow()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
