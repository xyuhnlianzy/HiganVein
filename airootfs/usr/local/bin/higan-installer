        rb_l.addWidget(QLabel("• <b>Memory:</b> 4 GB RAM minimum (8 GB recommended for gaming & dev workloads)"))
        rb_l.addWidget(QLabel("• <b>Storage:</b> 20 GB free disk space (SSD recommended for optimal responsiveness)"))
        l.addWidget(req_box)

        notice_box = QFrame()
        notice_box.setStyleSheet("background-color: #161214; border: 1px solid #3f2022; border-radius: 8px; padding: 12px;")
        nb_l = QVBoxLayout(notice_box)
        nb_l.setSpacing(4)
        nb_l.addWidget(QLabel("<b style='color: #ef4444;'>Beta Notice & Reporting:</b>"))
        notice_txt = QLabel(
            "This is a public beta release. Report partition issues, driver errors, or boot bugs "
            "directly to <b>github.com/xyuhnlianzy/HiganVein</b> with your hardware specs and installer logs."
        )
        notice_txt.setWordWrap(True)
        nb_l.addWidget(notice_txt)
        l.addWidget(notice_box)

        hb = QHBoxLayout()
        hb.addStretch()
        btn = QPushButton("Next: Select Storage →")
        btn.clicked.connect(lambda: self.set_step(1))
        hb.addWidget(btn)
        l.addLayout(hb)
        self.stack.addWidget(page)

    def init_storage(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(14)

        l.addWidget(QLabel("<b>Target Storage & Dual-Boot Allocation</b>"))
        
        l.addWidget(QLabel("Select Drive:"))
        self.disk_combo = QComboBox()
        self.populate_disks()
        self.disk_combo.currentIndexChanged.connect(self.on_disk_changed)
        l.addWidget(self.disk_combo)

        l.addWidget(QLabel("Installation Strategy:"))
        self.mode_group = QButtonGroup(self)
        self.radio_dual = QRadioButton("Install Alongside Existing OS (Dual-Boot)")
        self.radio_full = QRadioButton("Erase Entire Drive (Format 100% of selected drive)")
        self.radio_dual.setChecked(True)
        self.mode_group.addButton(self.radio_dual)
        self.mode_group.addButton(self.radio_full)
        l.addWidget(self.radio_dual)

        # Interactive Slider Box
        self.slider_box = QFrame()
        self.slider_box.setStyleSheet("background: #141418; border: 1px solid #27272a; border-radius: 10px; padding: 15px;")
        sb_layout = QVBoxLayout(self.slider_box)
        
        self.slider_lbl = QLabel("Allocated Disk Space: <b>50 GB</b>")
        sb_layout.addWidget(self.slider_lbl)

        self.size_slider = QSlider(Qt.Orientation.Horizontal)
        self.size_slider.setRange(20, 500)
        self.size_slider.setValue(50)
        self.size_slider.valueChanged.connect(self.on_slider_changed)
        sb_layout.addWidget(self.size_slider)
        l.addWidget(self.slider_box)

        l.addWidget(self.radio_full)
        self.radio_dual.toggled.connect(lambda chk: self.slider_box.setVisible(chk))

        fs_layout = QHBoxLayout()
        fs_layout.addWidget(QLabel("Root Filesystem:"))
        self.fs_combo = QComboBox()
        self.fs_combo.addItems(["ext4 (Recommended, rock-solid)", "btrfs (Advanced, snapshots)"])
        fs_layout.addWidget(self.fs_combo)
        fs_layout.addStretch()
        l.addLayout(fs_layout)

        l.addStretch()
        hb = QHBoxLayout()
        b1 = QPushButton("Back"); b1.setObjectName("secondary")
        b1.clicked.connect(lambda: self.set_step(0))
        b2 = QPushButton("Continue →")
        b2.clicked.connect(lambda: self.set_step(2))
        hb.addWidget(b1); hb.addWidget(b2)
        l.addLayout(hb)
        self.stack.addWidget(page)

    def on_slider_changed(self, val):
        self.slider_lbl.setText(f"Allocated Disk Space: <b>{val} GB</b>")

    def on_disk_changed(self):
        text = self.disk_combo.currentText()
        if "(" in text and "GB)" in text:
            try:
                max_gb = int(float(text.split("(")[1].split("GB)")[0].strip()))
                slider_max = max(30, max_gb - 10)
                self.size_slider.setMaximum(slider_max)
                if self.size_slider.value() > slider_max:
                    self.size_slider.setValue(max(20, slider_max // 2))
            except Exception:
                pass

    def populate_disks(self):
        self.disk_combo.clear()
        live_media = get_live_boot_device()
        disks = []

        for d in os.listdir("/sys/block"):
            if d.startswith("sd") or d.startswith("nvme") or d.startswith("vd"):
                dev_path = f"/dev/{d}"
                if live_media and dev_path == live_media:
                    continue

                try:
                    with open(f"/sys/block/{d}/ro", "r") as f:
                        if f.read().strip() == "0":
                            size_bytes = 0
                            try:
                                with open(f"/sys/block/{d}/size", "r") as sf:
                                    size_bytes = int(sf.read().strip()) * 512
                            except:
                                pass
                            size_gb = round(size_bytes / (1024**3), 1)

                            model = ""
                            try:
                                with open(f"/sys/block/{d}/device/model", "r") as mf:
                                    model = mf.read().strip()
                            except:
                                pass

                            label = f"{dev_path}"
                            if model:
                                label += f" - {model}"
                            label += f" ({size_gb} GB)"
                            disks.append(label)
                except:
                    pass

        if not disks:
            disks = ["/dev/sda"]
        self.disk_combo.addItems(disks)
        self.on_disk_changed()

    def init_account(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(14)

        l.addWidget(QLabel("<h2 style='color: white;'>User Profile & Security</h2>"))
        l.addWidget(QLabel("Set up your primary account and computer identity:"))

        l.addWidget(QLabel("Computer Name (Hostname):"))
        self.host_input = QLineEdit("higanveinos")
        l.addWidget(self.host_input)

        l.addWidget(QLabel("Full / Username:"))
        self.user_input = QLineEdit("higan")
        l.addWidget(self.user_input)

        l.addWidget(QLabel("Security Password:"))
        self.pass_input = QLineEdit()
        self.pass_input.setEchoMode(QLineEdit.EchoMode.Password)
        self.pass_input.setPlaceholderText("Enter secure password")
        l.addWidget(self.pass_input)

        l.addStretch()
        hb = QHBoxLayout()
        b1 = QPushButton("Back"); b1.setObjectName("secondary")
        b1.clicked.connect(lambda: self.set_step(1))
        b2 = QPushButton("Review Summary →")
        b2.clicked.connect(self.prepare_summary)
        hb.addWidget(b1); hb.addWidget(b2)
        l.addLayout(hb)
        self.stack.addWidget(page)

    def init_summary(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(15)

        l.addWidget(QLabel("<h2 style='color: white;'>Ready to Install</h2>"))
        l.addWidget(QLabel("Please review your installation preferences before proceeding:"))

        self.summary_card = QFrame()
        self.summary_card.setStyleSheet("background: #141418; border: 1px solid #27272a; border-radius: 10px; padding: 20px;")
        sc_layout = QVBoxLayout(self.summary_card)
        self.summary_lbl = QLabel()
        sc_layout.addWidget(self.summary_lbl)
        l.addWidget(self.summary_card)

        l.addStretch()
        hb = QHBoxLayout()
        b1 = QPushButton("Back"); b1.setObjectName("secondary")
        b1.clicked.connect(lambda: self.set_step(2))
        b2 = QPushButton("Install HiganveinOS Now")
        b2.clicked.connect(self.start_install)
        hb.addWidget(b1); hb.addWidget(b2)
        l.addLayout(hb)
        self.stack.addWidget(page)

    def init_progress(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(15)

        l.addWidget(QLabel("<h2 style='color: white;'>Installing HiganveinOS...</h2>"))
        
        self.p_bar = QProgressBar()
        self.p_bar.setStyleSheet("""
            QProgressBar { 
                background: #18181b; 
                border: 1px solid #27272a; 
                border-radius: 6px; 
                text-align: center; 
                color: white; 
                font-weight: bold;
                height: 24px;
            } 
            QProgressBar::chunk { 
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ef4444, stop:1 #b91c1c); 
                border-radius: 6px; 
            }
        """)
        l.addWidget(self.p_bar)

        self.status_lbl = QLabel("Initializing setup engine...")
        self.status_lbl.setStyleSheet("color: #e4e4e7; font-weight: bold;")
        l.addWidget(self.status_lbl)

        self.log_box = QTextEdit()
        self.log_box.setReadOnly(True)
        l.addWidget(self.log_box)
        self.stack.addWidget(page)

    def prepare_summary(self):
        disk_raw = self.disk_combo.currentText().split(" ")[0]
        fs_choice = "ext4" if "ext4" in self.fs_combo.currentText() else "btrfs"
        mode_text = f"Dual-Boot Alongside Existing OS ({self.size_slider.value()} GB Allocated)" if self.radio_dual.isChecked() else "Clean Drive Wipe (100% of Drive)"

        summary_text = f"""
<b>Target Drive:</b> {disk_raw}<br>
<b>Installation Strategy:</b> {mode_text}<br>
<b>Filesystem:</b> {fs_choice.upper()}<br>
<b>Computer Hostname:</b> {self.host_input.text()}<br>
<b>Primary User:</b> {self.user_input.text()}<br>
<b>Bootloader:</b> Universal UEFI GRUB (Dual-Boot & Windows Boot Manager Override)
        """
        self.summary_lbl.setText(summary_text.strip())
        self.set_step(3)

    def start_install(self):
        disk_raw = self.disk_combo.currentText().split(" ")[0]
        fs_choice = "ext4" if "ext4" in self.fs_combo.currentText() else "btrfs"
        config = {
            'disk': disk_raw,
            'fs': fs_choice,
            'username': self.user_input.text(),
            'password': self.pass_input.text(),
            'hostname': self.host_input.text(),
            'timezone': detect_system_timezone(),
            'install_mode': 'dualboot' if self.radio_dual.isChecked() else 'full',
            'size_gb': self.size_slider.value()
        }
        self.set_step(4)
        self.worker = CoreEngineWorker(config)
        self.worker.progress.connect(self.update_progress)
        self.worker.finished.connect(self.install_finished)
        self.worker.start()

    def update_progress(self, pct, msg, log):
        self.p_bar.setValue(pct)
        self.status_lbl.setText(msg)
        self.log_box.append(log)

    def install_finished(self, success, message):
        if success:
            QMessageBox.information(self, "Installation Complete", message)
        else:
            QMessageBox.critical(self, "Installation Failed", f"An error occurred during installation:\n{message}")

if __name__ == '__main__':
    app = QApplication(sys.argv)
    ex = HiganInstallerV4()
    ex.show()
    sys.exit(app.exec())
