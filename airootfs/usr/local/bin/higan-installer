    def on_mode_changed(self):
        is_erase = self.rad_erase.isChecked()
        is_along = self.rad_alongside.isChecked()
        is_manual = self.rad_manual.isChecked()

        self.erase_desc.setVisible(is_erase)
        self.dual_box.setVisible(is_along)
        self.manual_box.setVisible(is_manual)
        self.chk_encrypt.setVisible(not is_manual)
        self.chk_home.setVisible(not is_manual)

    def on_disk_changed(self, text):
        if not text:
            return
        disk_dev = text.split(" ")[0]
        parts = get_disk_partitions(disk_dev)
        try:
            with open(f"/sys/block/{os.path.basename(disk_dev)}/size", "r") as f:
                total_gb = round(int(f.read().strip()) * 512 / (1024**3), 1)
        except Exception:
            total_gb = sum(p["size_gb"] for p in parts) if parts else 100
        self.disk_bar.set_partitions(parts, total_gb)

    def launch_partition_manager(self):
        for tool in ["partitionmanager", "gparted"]:
            if shutil.which(tool):
                subprocess.Popen([tool])
                return
        QMessageBox.information(self, "Partition Manager", "No partition manager found. Install kde-partitionmanager or gparted.")

    def populate_disks(self):
        self.combo_disk.clear()
        live = get_live_boot_device()
        disks = []
        for d in sorted(os.listdir("/sys/block")):
            if d.startswith(("sd", "nvme", "vd")):
                dev_path = f"/dev/{d}"
                if live and dev_path == live:
                    continue
                try:
                    with open(f"/sys/block/{d}/ro") as rf:
                        if rf.read().strip() != "0":
                            continue
                    with open(f"/sys/block/{d}/size") as sf:
                        gb = round(int(sf.read().strip()) * 512 / (1024**3), 1)
                    model = ""
                    try:
                        with open(f"/sys/block/{d}/device/model") as mf:
                            model = mf.read().strip()
                    except Exception:
                        pass
                    dtype = "NVMe" if "nvme" in d else "SATA"
                    label = f"{dev_path} — {dtype} {gb} GB"
                    if model:
                        label += f" ({model})"
                    disks.append(label)
                except Exception:
                    pass
        if not disks:
            disks = ["/dev/sda — Unknown"]
        self.combo_disk.addItems(disks)

    # ── PAGE 5: USERS ────────────────────────────────────

    def init_page_users(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(14)

        l.addWidget(self.make_title("User Account"))
        l.addWidget(self.make_subtitle("Set up the primary user for this system."))

        l.addSpacing(4)

        fields = [
            ("YOUR NAME", "in_fullname", "D-P", False),
            ("COMPUTER NAME", "in_hostname", "higanvein", False),
            ("USERNAME", "in_username", "higan", False),
            ("PASSWORD", "in_password", "", True),
            ("CONFIRM PASSWORD", "in_confirm", "", True),
        ]

        for label_text, attr, default, is_pw in fields:
            lbl = QLabel(label_text)
            lbl.setStyleSheet("color: #52525b; font-size: 8pt; font-weight: 600; letter-spacing: 1px;")
            l.addWidget(lbl)
            inp = QLineEdit(default)
            if is_pw:
                inp.setEchoMode(QLineEdit.EchoMode.Password)
                inp.setPlaceholderText("Enter password" if attr == "in_password" else "Re-enter password")
            setattr(self, attr, inp)
            l.addWidget(inp)

        l.addSpacing(6)
        self.chk_autologin = QCheckBox("Log in automatically")
        self.chk_autologin.setChecked(True)
        self.chk_same_root = QCheckBox("Use same password for root (sudo)")
        self.chk_same_root.setChecked(True)
        l.addWidget(self.chk_autologin)
        l.addWidget(self.chk_same_root)

        l.addStretch()
        self.stack.addWidget(page)

    # ── PAGE 6: SUMMARY ──────────────────────────────────

    def init_page_summary(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(14)

        l.addWidget(self.make_title("Review"))
        l.addWidget(self.make_subtitle("Verify your settings before writing to disk."))

        l.addSpacing(4)

        card = self.make_card()
        cl = QVBoxLayout(card)
        cl.setContentsMargins(24, 20, 24, 20)
        cl.setSpacing(14)

        self.summary_items = {}
        for key in ["Location", "Keyboard", "Disk", "User"]:
            row = QVBoxLayout()
            row.setSpacing(2)
            header = QLabel(key.upper())
            header.setStyleSheet("color: #52525b; font-size: 8pt; font-weight: 600; letter-spacing: 1px;")
            value = QLabel("—")
            value.setStyleSheet("color: #e4e4e7; font-size: 10pt;")
            row.addWidget(header)
            row.addWidget(value)
            self.summary_items[key] = value
            cl.addLayout(row)

            if key != "User":
                sep = QFrame()
                sep.setFixedHeight(1)
                sep.setStyleSheet("background-color: #1a1a1e;")
                cl.addWidget(sep)

        l.addWidget(card)

        # Destructive warning
        warn = QFrame()
        warn.setStyleSheet("background-color: rgba(239,68,68,0.08); border: 1px solid #7f1d1d; border-radius: 6px;")
        wl = QHBoxLayout(warn)
        wl.setContentsMargins(14, 10, 14, 10)
        wt = QLabel("Clicking 'Install' will write changes to disk. This cannot be undone.")
        wt.setStyleSheet("color: #fca5a5; font-size: 9pt; font-weight: 500;")
        wl.addWidget(wt)
        l.addWidget(warn)

        l.addStretch()
        self.stack.addWidget(page)

    def update_summary(self):
        reg = self.combo_region.currentText()
        zone = self.combo_zone.currentText()
        self.summary_items["Location"].setText(f"{reg}/{zone}")

        kb = self.list_kb.currentItem()
        self.summary_items["Keyboard"].setText(kb.text() if kb else "English (US)")

        disk_txt = self.combo_disk.currentText().split(" ")[0]
        fs_txt = "Btrfs" if "Btrfs" in self.combo_fs.currentText() else "Ext4"
        boot_txt = self.combo_bootloader.currentText().split(" ")[0]
        if self.rad_erase.isChecked():
            mode = "Erase entire disk"
        elif self.rad_alongside.isChecked():
            mode = f"Dual-boot ({self.slider_size.value()} GB)"
        else:
            mode = "Manual partitioning"
        self.summary_items["Disk"].setText(f"{disk_txt}  ·  {mode}  ·  {fs_txt}  ·  {boot_txt}")

        user = self.in_username.text()
        host = self.in_hostname.text()
        auto = "yes" if self.chk_autologin.isChecked() else "no"
        self.summary_items["User"].setText(f"{user}@{host}  ·  autologin: {auto}")

    # ── PAGE 7: INSTALL ──────────────────────────────────

    def init_page_install(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(14)

        l.addWidget(self.make_title("Installing"))

        # Progress
        p_box = QVBoxLayout()
        p_box.setSpacing(6)

        self.progress_bar = QProgressBar()
        p_box.addWidget(self.progress_bar)

        stat_row = QHBoxLayout()
        self.lbl_progress_status = QLabel("Preparing...")
        self.lbl_progress_status.setStyleSheet("color: #a1a1aa; font-size: 9pt;")
        self.lbl_progress_pct = QLabel("0%")
        self.lbl_progress_pct.setStyleSheet("color: #ef4444; font-weight: 700; font-family: monospace; font-size: 10pt;")
        stat_row.addWidget(self.lbl_progress_status)
        stat_row.addStretch()
        stat_row.addWidget(self.lbl_progress_pct)
        p_box.addLayout(stat_row)
        l.addLayout(p_box)

        # Log
        self.log_terminal = QTextEdit()
        self.log_terminal.setReadOnly(True)
        self.log_terminal.setMinimumHeight(200)
        l.addWidget(self.log_terminal, stretch=1)

        self.stack.addWidget(page)

    def start_installation(self):
        raw_disk = self.combo_disk.currentText().split(" ")[0]
        fs = "btrfs" if "Btrfs" in self.combo_fs.currentText() else "ext4"
        tz = f"{self.combo_region.currentText()}/{self.combo_zone.currentText()}"
        boot_choice = self.combo_bootloader.currentText().split(" ")[0].lower()

        if self.rad_erase.isChecked():
            imode = "erase"
        elif self.rad_alongside.isChecked():
            imode = "alongside"
        else:
            imode = "manual"

        config = {
            'disk': raw_disk,
            'fs': fs,
            'bootloader': boot_choice,
            'fullname': self.in_fullname.text(),
            'username': self.in_username.text(),
            'password': self.in_password.text(),
            'hostname': self.in_hostname.text(),
            'timezone': tz,
            'install_mode': imode,
            'allocated_gb': self.slider_size.value(),
            'autologin': self.chk_autologin.isChecked(),
        }

        self.set_step(6)
        self.worker = InstallWorker(config)
        self.worker.progress.connect(self.on_progress)
        self.worker.finished.connect(self.on_finished)
        self.worker.start()

    def on_progress(self, pct, status, log_line):
        self.progress_bar.setValue(pct)
        self.lbl_progress_pct.setText(f"{pct}%")
        self.lbl_progress_status.setText(status)
        self.log_terminal.append(log_line)

    def on_finished(self, success, msg):
        if success:
            self.set_step(7)
        else:
            QMessageBox.critical(self, "Installation Failed", f"Error:\n{msg}")
            self.btn_next.setText("Retry")
            self.btn_next.setEnabled(True)

    # ── PAGE 8: FINISH ───────────────────────────────────

    def init_page_finish(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(16)
        l.setAlignment(Qt.AlignmentFlag.AlignCenter)

        # Check circle
        check = QLabel("✓")
        check.setAlignment(Qt.AlignmentFlag.AlignCenter)
        check.setStyleSheet("""
            background-color: #0f0f12;
            color: #22c55e;
            font-size: 36pt;
            font-weight: 700;
            border: 2px solid #22c55e;
            border-radius: 44px;
            min-width: 88px; max-width: 88px;
            min-height: 88px; max-height: 88px;
        """)
        l.addWidget(check, alignment=Qt.AlignmentFlag.AlignCenter)

        t = QLabel("Installation complete")
        t.setObjectName("page_title")
        l.addWidget(t, alignment=Qt.AlignmentFlag.AlignCenter)

        desc = QLabel("Remove installation media before rebooting.")
        desc.setStyleSheet("color: #71717a; font-size: 10pt;")
        desc.setAlignment(Qt.AlignmentFlag.AlignCenter)
        l.addWidget(desc)

        l.addSpacing(8)
        self.chk_restart = QCheckBox("Reboot now")
        self.chk_restart.setChecked(True)
        l.addWidget(self.chk_restart, alignment=Qt.AlignmentFlag.AlignCenter)

        self.stack.addWidget(page)


if __name__ == '__main__':
    app = QApplication(sys.argv)
    window = HiganInstallerApp()
    window.show()
    sys.exit(app.exec())
