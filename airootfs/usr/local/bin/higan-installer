        self.lbl_progress_pct.setStyleSheet("color: #ef4444; font-weight: bold; font-size: 10pt;")
        st_row.addWidget(self.lbl_progress_status)
        st_row.addStretch()
        st_row.addWidget(self.lbl_progress_pct)
        p_row.addLayout(st_row)
        l.addLayout(p_row)

        self.stack.addWidget(page)

    def start_installation(self):
        raw_disk = self.combo_disk.currentText().split(" ")[0]
        fs = "btrfs" if "Btrfs" in self.combo_fs.currentText() else "ext4"
        timezone = f"{self.combo_region.currentText()}/{self.combo_zone.currentText()}"

        config = {
            'disk': raw_disk,
            'fs': fs,
            'fullname': self.in_fullname.text(),
            'username': self.in_username.text(),
            'password': self.in_password.text(),
            'hostname': self.in_hostname.text(),
            'timezone': timezone,
            'install_mode': 'erase' if self.rad_erase.isChecked() else 'alongside',
            'autologin': self.chk_autologin.isChecked()
        }

        self.set_step(6)
        self.worker = InstallWorker(config)
        self.worker.progress.connect(self.on_progress)
        self.worker.finished.connect(self.on_finished)
        self.worker.start()

    def on_progress(self, pct, status_msg, log_line):
        self.progress_bar.setValue(pct)
        self.lbl_progress_pct.setText(f"{pct}%")
        self.lbl_progress_status.setText(status_msg)
        self.log_terminal.append(log_line)

    def on_finished(self, success, msg):
        if success:
            self.set_step(7)
        else:
            QMessageBox.critical(self, "Installation Error", f"Installation failed:\n{msg}")

    # ---------------- PAGE 8: FINISH ----------------
