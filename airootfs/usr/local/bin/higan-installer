#!/usr/bin/env python3
"""
HiganveinOS Installer v5.0
Design: EndeavourOS-grade dark sidebar, Calamares partition bars,
Ubuntu-grade spacing, Fedora-grade scenario partitioning.
8 steps: Welcome, Location, Keyboard, Partitioning, Users, Summary, Install, Finish.
"""

import sys, os, subprocess, shutil, time, json
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton,
    QStackedWidget, QComboBox, QLineEdit, QProgressBar, QMessageBox, QFrame,
    QTextEdit, QRadioButton, QButtonGroup, QCheckBox, QListWidget, QSlider,
    QSizePolicy, QScrollArea
)
from PyQt6.QtCore import Qt, QThread, pyqtSignal, QSize
from PyQt6.QtGui import QFont, QColor, QPalette, QPainter, QBrush, QPen


# ── Utility ──────────────────────────────────────────────

def get_live_boot_device():
    try:
        with open("/proc/mounts", "r") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2:
                    dev, mp = parts[0], parts[1]
                    if "archiso" in mp and dev.startswith("/dev/"):
                        real = os.path.realpath(dev)
                        base = os.path.basename(real)
                        for d in os.listdir("/sys/block"):
                            if base.startswith(d):
                                return f"/dev/{d}"
    except Exception:
        pass
    return ""


def find_existing_esp(disk):
    try:
        out = subprocess.run(
            ["lsblk", "-J", "-o", "NAME,PARTTYPE,FSTYPE", disk],
            capture_output=True, text=True
        ).stdout
        data = json.loads(out)
        for dev in data.get("blockdevices", []):
            for part in dev.get("children", []):
                ptype = (part.get("parttype") or "").lower()
                fstype = (part.get("fstype") or "").lower()
                if "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" in ptype or fstype == "vfat":
                    return f"/dev/{part['name']}"
    except Exception:
        pass
    return None


def get_disk_partitions(disk):
    """Return list of {name, size_gb, fstype, label} for disk bar visualization."""
    parts = []
    try:
        out = subprocess.run(
            ["lsblk", "-J", "-b", "-o", "NAME,SIZE,FSTYPE,LABEL,TYPE", disk],
            capture_output=True, text=True
        ).stdout
        data = json.loads(out)
        for dev in data.get("blockdevices", []):
            for child in dev.get("children", []):
                if child.get("type") in ("part", "partition"):
                    sz = int(child.get("size", 0))
                    parts.append({
                        "name": child["name"],
                        "size_gb": round(sz / (1024**3), 1),
                        "fstype": child.get("fstype") or "unknown",
                        "label": child.get("label") or child["name"],
                    })
    except Exception:
        pass
    return parts


# ── Disk Bar Widget ──────────────────────────────────────

PART_COLORS = {
    "ext4": "#3b82f6", "btrfs": "#ef4444", "ntfs": "#8b5cf6",
    "vfat": "#06b6d4", "fat32": "#06b6d4", "swap": "#eab308",
    "unknown": "#3f3f46", "free": "#27272a",
}


class DiskBarWidget(QFrame):
    """Horizontal color-coded partition bar (Calamares-style)."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedHeight(36)
        self.setStyleSheet("background: #18181b; border-radius: 6px;")
        self.partitions = []
        self.total_gb = 0

    def set_partitions(self, parts, total_gb):
        self.partitions = parts
        self.total_gb = max(total_gb, 1)
        self.update()

    def paintEvent(self, event):
        super().paintEvent(event)
        if not self.partitions or self.total_gb <= 0:
            return
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w = self.width() - 4
        x = 2
        for part in self.partitions:
            frac = part["size_gb"] / self.total_gb
            pw = max(int(w * frac), 4)
            color = PART_COLORS.get(part["fstype"], "#3f3f46")
            p.setBrush(QBrush(QColor(color)))
            p.setPen(QPen(QColor("#09090b"), 1))
            p.drawRoundedRect(int(x), 2, pw, 32, 4, 4)
            if pw > 50:
                p.setPen(QColor("#e4e4e7"))
                p.setFont(QFont("monospace", 8))
                label = f"{part['label']} {part['size_gb']}G"
                p.drawText(int(x) + 6, 22, label)
            x += pw
        p.end()


# ── Install Worker ───────────────────────────────────────

class InstallWorker(QThread):
    progress = pyqtSignal(int, str, str)
    finished = pyqtSignal(bool, str)

    def __init__(self, config):
        super().__init__()
        self.config = config

    def run(self):
        try:
            disk = self.config['disk']
            fs = self.config['fs']
            username = self.config['username']
            password = self.config['password']
            hostname = self.config['hostname']
            fullname = self.config['fullname']
            timezone = self.config['timezone']
            install_mode = self.config['install_mode']
            autologin = self.config.get('autologin', True)

            def log(msg):
                print(f"[HiganInstall] {msg}")
                self.progress.emit(self.current_pct, self.current_msg, msg)

            self.current_pct = 5
            self.current_msg = "Preparing storage..."
            log(f"> Target: {disk} | FS: {fs.upper()} | Mode: {install_mode}")

            esp_part = None
            root_part = None

            if install_mode == "erase":
                log(f"> Unmounting partitions on {disk}...")
                for part in os.listdir("/dev"):
                    if part.startswith(os.path.basename(disk)) and part != os.path.basename(disk):
                        p_path = f"/dev/{part}"
                        subprocess.run(["swapoff", p_path], stderr=subprocess.DEVNULL)
                        subprocess.run(["umount", "-l", p_path], stderr=subprocess.DEVNULL)

                self.current_pct = 15
                self.current_msg = "Creating partition table (GPT)..."
                log(f"> Wiping {disk}...")
                subprocess.run(["wipefs", "-a", "--force", disk], stderr=subprocess.DEVNULL)
                subprocess.run(["sgdisk", "--zap-all", disk], stderr=subprocess.DEVNULL)
                subprocess.run(["partprobe", disk], stderr=subprocess.DEVNULL)
                time.sleep(1)

                log("> Creating ESP (512 MB) + root partition...")
                subprocess.run(["parted", "-s", disk, "mklabel", "gpt"], check=True)
                subprocess.run(["parted", "-s", disk, "mkpart", "ESP", "fat32", "1MiB", "513MiB"], check=True)
                subprocess.run(["parted", "-s", disk, "set", "1", "esp", "on"], check=True)
                subprocess.run(["parted", "-s", disk, "mkpart", "root", "513MiB", "100%"], check=True)
                subprocess.run(["partprobe", disk], check=True)
                time.sleep(1)

                if "nvme" in disk:
                    esp_part = f"{disk}p1"
                    root_part = f"{disk}p2"
                else:
                    esp_part = f"{disk}1"
                    root_part = f"{disk}2"

            elif install_mode == "alongside":
                allocated_gb = self.config.get('allocated_gb', 64)
                log(f"> Dual-boot: allocating {allocated_gb} GB on {disk}")
                esp_part = find_existing_esp(disk)
                if not esp_part:
                    log("! No existing ESP found. Creating new one.")
                    subprocess.run(["parted", "-s", disk, "mkpart", "ESP", "fat32", "1MiB", "513MiB"], check=True)
                    subprocess.run(["parted", "-s", disk, "set", "1", "esp", "on"], check=True)
                    esp_part = f"{disk}p1" if "nvme" in disk else f"{disk}1"

                out = subprocess.run(["parted", "-s", disk, "unit", "MB", "print", "free"], capture_output=True, text=True).stdout
                free_start = None
                for line in out.splitlines():
                    if "Free Space" in line:
                        parts = line.split()
                        free_start = parts[0]
                if free_start:
                    end = f"{int(free_start.replace('MB', '')) + allocated_gb * 1024}MB"
                    subprocess.run(["parted", "-s", disk, "mkpart", "higanvein", free_start, end], check=True)
                    subprocess.run(["partprobe", disk], check=True)
                    time.sleep(1)

                devs = sorted([f"/dev/{d}" for d in os.listdir("/dev") if d.startswith(os.path.basename(disk)) and d != os.path.basename(disk)])
                root_part = devs[-1] if devs else f"{disk}2"

            self.current_pct = 25
            self.current_msg = f"Formatting {fs.upper()}..."
            if esp_part and install_mode == "erase":
                log(f"> Formatting ESP: {esp_part}")
                subprocess.run(["mkfs.fat", "-F", "32", esp_part], check=True)

            if root_part:
                log(f"> Formatting root: {root_part} as {fs}")
                if fs == "btrfs":
                    subprocess.run(["mkfs.btrfs", "-f", root_part], check=True)
                else:
                    subprocess.run(["mkfs.ext4", "-F", root_part], check=True)

            self.current_pct = 30
            self.current_msg = "Mounting filesystems..."
            target = "/mnt/higan-target"
            os.makedirs(target, exist_ok=True)

            if fs == "btrfs":
                subprocess.run(["mount", root_part, target], check=True)
                for sv in ["@", "@home", "@snapshots"]:
                    subprocess.run(["btrfs", "subvolume", "create", f"{target}/{sv}"], check=True)
                subprocess.run(["umount", target], check=True)
                subprocess.run(["mount", "-o", "subvol=@,compress=zstd,noatime", root_part, target], check=True)
                os.makedirs(f"{target}/home", exist_ok=True)
                subprocess.run(["mount", "-o", "subvol=@home,compress=zstd,noatime", root_part, f"{target}/home"], check=True)
                os.makedirs(f"{target}/.snapshots", exist_ok=True)
                subprocess.run(["mount", "-o", "subvol=@snapshots,compress=zstd,noatime", root_part, f"{target}/.snapshots"], check=True)
            else:
                subprocess.run(["mount", root_part, target], check=True)

            if esp_part:
                os.makedirs(f"{target}/boot/efi", exist_ok=True)
                subprocess.run(["mount", esp_part, f"{target}/boot/efi"], check=True)

            self.current_pct = 40
            self.current_msg = "Copying system files..."
            log("> rsync from live filesystem...")
            rsync_exclude = [
                "/dev/*", "/proc/*", "/sys/*", "/run/*", "/tmp/*",
                "/mnt/*", "/lost+found", "/swapfile"
            ]
            rsync_cmd = ["rsync", "-aAXH", "--one-file-system", "--ignore-errors", "--info=progress2"]
            for ex in rsync_exclude:
                rsync_cmd += ["--exclude", ex]
            rsync_cmd += ["/", f"{target}/"]

            proc = subprocess.Popen(rsync_cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in proc.stdout:
                line = line.strip()
                if "%" in line:
                    try:
                        pct_str = line.split("%")[0].strip().split()[-1]
                        pct = int(pct_str)
                        self.current_pct = 40 + int(pct * 0.4)
                        log(f"  rsync: {pct}%")
                    except (ValueError, IndexError):
                        pass
            proc.wait()

            self.current_pct = 82
            self.current_msg = "Configuring system..."
            log("> Writing fstab...")
            subprocess.run(["bash", "-c", f"genfstab -U {target} >> {target}/etc/fstab"], check=True)

            log(f"> Setting timezone: {timezone}")
            subprocess.run(["arch-chroot", target, "ln", "-sf", f"/usr/share/zoneinfo/{timezone}", "/etc/localtime"], check=True)
            subprocess.run(["arch-chroot", target, "hwclock", "--systohc"], check=True)

            log(f"> Setting hostname: {hostname}")
            with open(f"{target}/etc/hostname", "w") as f:
                f.write(hostname + "\n")
            with open(f"{target}/etc/hosts", "w") as f:
                f.write(f"127.0.0.1 localhost\n::1 localhost\n127.0.1.1 {hostname}\n")

            log("> Generating locale (en_US.UTF-8)...")
            with open(f"{target}/etc/locale.gen", "a") as f:
                f.write("en_US.UTF-8 UTF-8\n")
            subprocess.run(["arch-chroot", target, "locale-gen"], check=True)
            with open(f"{target}/etc/locale.conf", "w") as f:
                f.write("LANG=en_US.UTF-8\n")

            self.current_pct = 85
            self.current_msg = "Creating user account..."
            log(f"> Creating user: {username}")
            subprocess.run(["arch-chroot", target, "useradd", "-m", "-G", "wheel,video,audio,storage,optical,network,power", "-c", fullname, "-s", "/bin/bash", username], check=True)
            subprocess.run(["arch-chroot", target, "bash", "-c", f"echo '{username}:{password}' | chpasswd"], check=True)
            subprocess.run(["arch-chroot", target, "bash", "-c", f"echo 'root:{password}' | chpasswd"], check=True)

            sudoers = f"{target}/etc/sudoers.d/10-{username}"
            with open(sudoers, "w") as f:
                f.write(f"{username} ALL=(ALL) ALL\n")

            if autologin:
                sddm_conf = f"{target}/etc/sddm.conf.d/autologin.conf"
                os.makedirs(os.path.dirname(sddm_conf), exist_ok=True)
                with open(sddm_conf, "w") as f:
                    f.write(f"[Autologin]\nUser={username}\nSession=plasma\n")

            self.current_pct = 88
            bootloader = self.config.get('bootloader', 'limine')
            self.current_msg = f"Installing bootloader ({bootloader.upper()})..."
            log(f"> Installing chosen bootloader: {bootloader.upper()}...")

            root_uuid = subprocess.run(["blkid", "-s", "UUID", "-o", "value", root_part], capture_output=True, text=True).stdout.strip()

            if bootloader == "limine":
                limine_efi_src = f"{target}/usr/share/limine/BOOTX64.EFI"
                if os.path.exists(limine_efi_src):
                    efi_boot = f"{target}/boot/efi/EFI/BOOT"
                    os.makedirs(efi_boot, exist_ok=True)
                    shutil.copy2(limine_efi_src, f"{efi_boot}/BOOTX64.EFI")

                    limine_cfg = f"{target}/boot/efi/limine.conf"
                    with open(limine_cfg, "w") as f:
                        f.write(f"""timeout: 5
interface_branding: HiganveinOS
default_entry: 1

/HiganveinOS
    protocol: linux
    kernel_path: boot():/vmlinuz-linux-cachyos
    kernel_cmdline: root=UUID={root_uuid} rw loglevel=3 quiet
    module_path: boot():/initramfs-linux-cachyos.img
""")
                    log(f"  Limine EFI installed (root UUID: {root_uuid})")

            elif bootloader == "systemd-boot":
                log("> Setting up systemd-boot...")
                subprocess.run(["arch-chroot", target, "bootctl", "--path=/boot/efi", "install"], check=True)
                loader_conf = f"{target}/boot/efi/loader/loader.conf"
                os.makedirs(os.path.dirname(loader_conf), exist_ok=True)
                with open(loader_conf, "w") as f:
                    f.write("default higanveinos.conf\ntimeout 5\nconsole-mode max\n")
                
                entry_conf = f"{target}/boot/efi/loader/entries/higanveinos.conf"
                os.makedirs(os.path.dirname(entry_conf), exist_ok=True)
                with open(entry_conf, "w") as f:
                    f.write(f"""title HiganveinOS
linux /vmlinuz-linux-cachyos
initrd /initramfs-linux-cachyos.img
options root=UUID={root_uuid} rw loglevel=3 quiet
""")
                log("  systemd-boot entries created.")

            else: # GRUB
                log("> Setting up GRUB EFI...")
                subprocess.run([
                    "arch-chroot", target,
                    "grub-install", "--target=x86_64-efi",
                    "--efi-directory=/boot/efi", "--bootloader-id=HiganveinOS",
                    "--removable"
                ], check=True)

                grub_default = f"{target}/etc/default/grub"
                if os.path.exists(grub_default):
                    with open(grub_default, "r") as f:
                        content = f.read()
                    content = content.replace("GRUB_DISABLE_OS_PROBER=true", "GRUB_DISABLE_OS_PROBER=false")
                    if "GRUB_DISABLE_OS_PROBER" not in content:
                        content += "\nGRUB_DISABLE_OS_PROBER=false\n"
                    with open(grub_default, "w") as f:
                        f.write(content)

                subprocess.run(["arch-chroot", target, "grub-mkconfig", "-o", "/boot/grub/grub.cfg"], check=True)
                log("  GRUB configured with os-prober.")

            self.current_pct = 95
            self.current_msg = "Generating initramfs..."
            subprocess.run(["arch-chroot", target, "mkinitcpio", "-P"], check=True)

            self.current_pct = 98
            self.current_msg = "Cleaning up..."
            subprocess.run(["umount", "-R", target], stderr=subprocess.DEVNULL)

            self.current_pct = 100
            self.current_msg = "Installation complete."
            self.finished.emit(True, "Installation completed successfully.")

        except Exception as e:
            self.finished.emit(False, str(e))


# ── Step Indicator Widget ────────────────────────────────

class StepIndicator(QFrame):
    """Single sidebar step: circle + label."""

    def __init__(self, index, name, parent=None):
        super().__init__(parent)
        self.index = index
        self.name = name
        self.state = "future"  # future | active | completed
        self.setFixedHeight(36)
        self.setCursor(Qt.CursorShape.ArrowCursor)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 0, 12, 0)
        lay.setSpacing(10)

        self.circle = QLabel()
        self.circle.setFixedSize(22, 22)
        self.circle.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(self.circle)

        self.label = QLabel(name)
        self.label.setFont(QFont("Inter", 10, QFont.Weight.Medium))
        lay.addWidget(self.label)
        lay.addStretch()

        self.update_state("future")

    def update_state(self, state):
        self.state = state
        if state == "active":
            self.circle.setStyleSheet(
                "background-color: #ef4444; border-radius: 11px; color: #fff; font-size: 9px; font-weight: 700;"
            )
            self.circle.setText(str(self.index + 1))
            self.label.setStyleSheet("color: #fafafa; font-weight: 600;")
            self.setStyleSheet("background-color: rgba(239,68,68,0.08); border-left: 3px solid #ef4444; border-radius: 0;")
        elif state == "completed":
            self.circle.setStyleSheet(
                "background-color: #22c55e; border-radius: 11px; color: #fff; font-size: 11px; font-weight: 700;"
            )
            self.circle.setText("✓")
            self.label.setStyleSheet("color: #a1a1aa; font-weight: 500;")
            self.setStyleSheet("background: transparent; border: none;")
        else:
            self.circle.setStyleSheet(
                "background-color: transparent; border: 2px solid #3f3f46; border-radius: 11px; color: #52525b; font-size: 9px; font-weight: 600;"
            )
            self.circle.setText(str(self.index + 1))
            self.label.setStyleSheet("color: #52525b; font-weight: 400;")
            self.setStyleSheet("background: transparent; border: none;")


