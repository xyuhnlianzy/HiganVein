#!/usr/bin/env bash
# HiganveinOS Core CLI Live Boot Initializer

# 1. Ensure user higan owns their home folder
chown -R 1000:1000 /home/higan 2>/dev/null || true

# 1a. Apply Higanvein Void wallpaper over XFCE defaults at runtime to prevent pacman file conflicts
if [ -f /usr/share/backgrounds/xfce/higanvein-wallpaper.jpg ]; then
    cp -f /usr/share/backgrounds/xfce/higanvein-wallpaper.jpg /usr/share/backgrounds/xfce/xfce-blue.jpg 2>/dev/null || true
    cp -f /usr/share/backgrounds/xfce/higanvein-wallpaper.jpg /usr/share/backgrounds/xfce/xfce-stripes.png 2>/dev/null || true
fi

# 1b. Ensure Lycoris is default browser in XFCE helpers.rc (applied at runtime to avoid package file collision)
mkdir -p /etc/xdg/xfce4
echo "WebBrowser=lycoris" > /etc/xdg/xfce4/helpers.rc
echo "FileManager=Thunar" >> /etc/xdg/xfce4/helpers.rc
echo "TerminalEmulator=xfce4-terminal" >> /etc/xdg/xfce4/helpers.rc

# 2. Restore kernel and ucodes to live /boot so they exist in live filesystem
mkdir -p /boot
for mod_dir in /usr/lib/modules/*; do
    if [ -f "$mod_dir/vmlinuz" ]; then
        pkgbase="$(cat "$mod_dir/pkgbase" 2>/dev/null || echo "linux-cachyos")"
        if [ ! -f "/boot/vmlinuz-$pkgbase" ]; then
            cp -f "$mod_dir/vmlinuz" "/boot/vmlinuz-$pkgbase" 2>/dev/null || true
        fi
    fi
done

for bootmnt in /run/archiso/bootmnt /run/archiso/bootmnt/arch/boot; do
    if [ -d "$bootmnt" ]; then
        cp -f "$bootmnt"/intel-ucode.img /boot/ 2>/dev/null || true
        cp -f "$bootmnt"/amd-ucode.img /boot/ 2>/dev/null || true
        cp -f "$bootmnt"/x86_64/vmlinuz* /boot/ 2>/dev/null || true
    fi
done

# 4. Auto-launch Higanvein Unified Shell on tty1 login
if [ "$(tty)" = "/dev/tty1" ] && [ -z "$WAYLAND_DISPLAY" ]; then
    exec /usr/local/bin/higanvein-shell
fi
