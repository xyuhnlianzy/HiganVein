                border-radius: 4px;
            }
        """)
        p_row.addWidget(self.progress_bar)

        st_row = QHBoxLayout()
        self.lbl_progress_status = QLabel("Starting installation...")
        self.lbl_progress_status.setStyleSheet("color: #a1a1aa; font-size: 10pt;")
