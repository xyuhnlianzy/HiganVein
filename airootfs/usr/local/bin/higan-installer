        self.init_welcome()
        self.init_storage()
        self.init_account()
        self.init_summary()
        self.init_progress()

        self.update_nav(0)

    def update_nav(self, current_idx):
        for idx, lbl in enumerate(self.nav_labels):
            if idx == current_idx:
                lbl.setObjectName("nav_item_active")
            else:
                lbl.setObjectName("nav_item")
            lbl.style().unpolish(lbl)
            lbl.style().polish(lbl)

    def set_step(self, idx):
        self.stack.setCurrentIndex(idx)
        self.update_nav(idx)

