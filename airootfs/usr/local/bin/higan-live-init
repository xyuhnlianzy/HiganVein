#!/usr/bin/env bash
# HiganveinOS Live Boot Initializer
# Runs before SDDM/Display Manager

# 1. Ensure user higan owns their home folder
chown -R 1000:1000 /home/higan 2>/dev/null || true

# 2. Overwrite Breeze default wallpapers with Higan Void wallpaper
WP="/usr/share/wallpapers/Higanvein/higanvein-default.jpg"
if [ -f "$WP" ]; then
    for dir in /usr/share/wallpapers/Next/contents/images /usr/share/wallpapers/Next/contents/images_dark; do
        if [ -d "$dir" ]; then
            for img in "$dir"/*; do
                cp -f "$WP" "$img" 2>/dev/null || true
            done
        fi
    done
    if [ -d /usr/share/wallpapers/cachyos-wallpapers ]; then
        for img in /usr/share/wallpapers/cachyos-wallpapers/*; do
            cp -f "$WP" "$img" 2>/dev/null || true
        done
    fi
fi

# 3. Restore kernel and ucodes to live /boot so they exist in live filesystem
mkdir -p /boot
for mod_dir in /usr/lib/modules/*; do
    if [ -f "$mod_dir/vmlinuz" ]; then
        pkgbase="$(cat "$mod_dir/pkgbase" 2>/dev/null || echo "linux-cachyos")"
        if [ ! -f "/boot/vmlinuz-$pkgbase" ]; then
            cp -f "$mod_dir/vmlinuz" "/boot/vmlinuz-$pkgbase" 2>/dev/null || true
        fi
    fi
done

# Copy ucode and kernel from ISO boot mount if mounted
for bootmnt in /run/archiso/bootmnt /run/archiso/bootmnt/arch/boot; do
    if [ -d "$bootmnt" ]; then
        cp -f "$bootmnt"/intel-ucode.img /boot/ 2>/dev/null || true
        cp -f "$bootmnt"/amd-ucode.img /boot/ 2>/dev/null || true
        cp -f "$bootmnt"/x86_64/vmlinuz* /boot/ 2>/dev/null || true
    fi
done
