#!/usr/bin/env python3
"""
HiganveinOS Professional Installer (Design Parity Edition)
Based on official UI mockups:
- Left sidebar with H.V monogram branding and active red pill indicator
- Steps: Welcome, Location, Keyboard, Partitioning, Users, Summary, Install, Finish
- Clean dark theme (#0f0f12), precise typography, card-based layouts
- Full dual-boot, custom disk size, LUKS checkbox, and multi-OS GRUB integration
"""

import sys, os, subprocess, shutil, time, json
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, 
    QStackedWidget, QComboBox, QLineEdit, QProgressBar, QMessageBox, QFrame, 
    QTextEdit, QRadioButton, QButtonGroup, QCheckBox, QListWidget, QListWidgetItem
)
from PyQt6.QtCore import Qt, QThread, pyqtSignal
from PyQt6.QtGui import QFont, QColor, QPalette

def get_live_boot_device():
    try:
        with open("/proc/mounts", "r") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2:
                    dev, mountpoint = parts[0], parts[1]
                    if mountpoint in ("/run/archiso/bootmnt", "/run/archiso/airootfs") or "archiso" in mountpoint:
                        if dev.startswith("/dev/"):
                            real_dev = os.path.realpath(dev)
                            base_name = os.path.basename(real_dev)
                            for d in os.listdir("/sys/block"):
                                if base_name.startswith(d):
                                    return f"/dev/{d}"
    except Exception:
        pass
    return ""

def find_existing_esp(disk):
    try:
        out = subprocess.run(["lsblk", "-J", "-o", "NAME,PARTTYPE,FSTYPE", disk], capture_output=True, text=True).stdout
        data = json.loads(out)
        for dev in data.get("blockdevices", []):
            for part in dev.get("children", []):
                ptype = (part.get("parttype") or "").lower()
                fstype = (part.get("fstype") or "").lower()
                if "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" in ptype or fstype == "vfat":
                    return f"/dev/{part['name']}"
    except Exception:
        pass
    return None

class InstallWorker(QThread):
    progress = pyqtSignal(int, str, str)
    finished = pyqtSignal(bool, str)

    def __init__(self, config):
        super().__init__()
        self.config = config

    def run(self):
        try:
            disk = self.config['disk']
            fs = self.config['fs']
            username = self.config['username']
            password = self.config['password']
            hostname = self.config['hostname']
            fullname = self.config['fullname']
            timezone = self.config['timezone']
            install_mode = self.config['install_mode']
            autologin = self.config.get('autologin', True)

            def log(msg):
                print(f"[HiganInstall] {msg}")
                self.progress.emit(self.current_pct, self.current_msg, msg)

            self.current_pct = 5
            self.current_msg = "Preparing storage environment..."
            log(f"> Target drive: {disk} | Filesystem: {fs.upper()}")

            esp_part = None
            root_part = None

            if install_mode == "erase":
                log(f"> Disabling swap and unmounting partitions on {disk}...")
                for part in os.listdir("/dev"):
                    if part.startswith(os.path.basename(disk)) and part != os.path.basename(disk):
                        p_path = f"/dev/{part}"
                        subprocess.run(["swapoff", p_path], stderr=subprocess.DEVNULL)
                        subprocess.run(["umount", "-l", p_path], stderr=subprocess.DEVNULL)

                self.current_pct = 15
                self.current_msg = "Creating partition table (GPT)..."
                log(f"> Erasing partition signatures on {disk}...")
                subprocess.run(["wipefs", "-a", "--force", disk], stderr=subprocess.DEVNULL)
                subprocess.run(["sgdisk", "--zap-all", disk], stderr=subprocess.DEVNULL)
                subprocess.run(["partprobe", disk], stderr=subprocess.DEVNULL)
                time.sleep(1)

                log("> Creating ESP (512MB) and Root partition (100%)...")
                subprocess.run(["parted", "-s", disk, "mklabel", "gpt"], check=True)
                subprocess.run(["parted", "-s", disk, "mkpart", "esp", "fat32", "1MiB", "512MiB"], check=True)
                subprocess.run(["parted", "-s", disk, "set", "1", "esp", "on"], check=True)
                subprocess.run(["parted", "-s", disk, "mkpart", "root", fs, "512MiB", "100%"], check=True)
                subprocess.run(["partprobe", disk], stderr=subprocess.DEVNULL)
                time.sleep(1)

                if "nvme" in disk or "loop" in disk or "mmcblk" in disk:
                    esp_part = f"{disk}p1"
                    root_part = f"{disk}p2"
                else:
                    esp_part = f"{disk}1"
                    root_part = f"{disk}2"

                log(f"> Formatting {esp_part} as FAT32 (ESP)...")
                subprocess.run(["mkfs.fat", "-F32", esp_part], check=True)
            else:
                self.current_pct = 15
                self.current_msg = "Allocating partition space for dual-boot..."
                log("> Checking existing EFI partition...")
                existing_esp = find_existing_esp(disk)
                if existing_esp:
                    log(f"> Found existing ESP: {existing_esp}")
                    esp_part = existing_esp

                parted_out = subprocess.run(["parted", "-m", disk, "unit", "MiB", "print"], capture_output=True, text=True).stdout
                last_end = 1024
                for line in parted_out.splitlines():
                    if line.startswith(disk) or not line or ":" not in line:
                        continue
                    fields = line.split(":")
                    if len(fields) >= 3 and fields[0].isdigit():
                        try:
                            last_end = max(last_end, int(float(fields[2].replace("MiB", "").strip())))
                        except ValueError:
                            pass

                start_mib = last_end + 1
                if not esp_part:
                    esp_end = start_mib + 512
                    log(f"> Creating new ESP: {start_mib}MiB to {esp_end}MiB...")
                    subprocess.run(["parted", "-s", disk, "mkpart", "esp", "fat32", f"{start_mib}MiB", f"{esp_end}MiB"], check=True)
                    start_mib = esp_end + 1
                    subprocess.run(["partprobe", disk], stderr=subprocess.DEVNULL)
                    time.sleep(1)

                log(f"> Creating Root partition starting at {start_mib}MiB to 100%...")
                subprocess.run(["parted", "-s", disk, "mkpart", "root", fs, f"{start_mib}MiB", "100%"], check=True)
                subprocess.run(["partprobe", disk], stderr=subprocess.DEVNULL)
                time.sleep(1)

                parts = [f"/dev/{p}" for p in os.listdir("/dev") if p.startswith(os.path.basename(disk)) and p != os.path.basename(disk)]
                parts.sort()
                root_part = parts[-1]
                if not esp_part:
                    esp_part = parts[-2]
                    subprocess.run(["mkfs.fat", "-F32", esp_part], check=True)

            self.current_pct = 25
            self.current_msg = f"Formatting {root_part} as {fs.upper()}..."
            log(f"> Formatting {root_part} as {fs}...")
            if fs == "btrfs":
                subprocess.run(["mkfs.btrfs", "-f", root_part], check=True)
            else:
                subprocess.run(["mkfs.ext4", "-F", root_part], check=True)

            self.current_pct = 35
            self.current_msg = "Mounting target filesystems..."
            log(f"> Mounting root to /mnt/higan-target...")
            os.makedirs("/mnt/higan-target", exist_ok=True)
            subprocess.run(["mount", root_part, "/mnt/higan-target"], check=True)
            os.makedirs("/mnt/higan-target/boot/efi", exist_ok=True)
            subprocess.run(["mount", esp_part, "/mnt/higan-target/boot/efi"], check=True)

            self.current_pct = 50
            self.current_msg = "Installing base system files..."
            log("> Copying system image to target drive via rsync...")
            subprocess.run([
                "rsync", "-aAXH", "--one-file-system", "--ignore-errors",
                "--exclude=/dev", "--exclude=/proc", "--exclude=/sys", 
                "--exclude=/run", "--exclude=/tmp", "--exclude=/mnt",
                "--exclude=/lost+found", "--exclude=/var/cache",
                "/", "/mnt/higan-target/"
            ], check=True)

            self.current_pct = 70
            self.current_msg = "Configuring system locale & fstab..."
            log("> Generating fstab with UUID mapping...")
            with open("/mnt/higan-target/etc/fstab", "w") as f:
                root_uuid = subprocess.run(["blkid", "-s", "UUID", "-o", "value", root_part], capture_output=True, text=True).stdout.strip()
                esp_uuid = subprocess.run(["blkid", "-s", "UUID", "-o", "value", esp_part], capture_output=True, text=True).stdout.strip()
                f.write(f"# HiganveinOS Fstab\n")
                f.write(f"UUID={root_uuid} / {fs} defaults 0 1\n")
                f.write(f"UUID={esp_uuid} /boot/efi vfat umask=0077 0 2\n")

            with open("/mnt/higan-target/etc/hostname", "w") as f:
                f.write(hostname + "\n")

            subprocess.run(["arch-chroot", "/mnt/higan-target", "ln", "-sf", f"/usr/share/zoneinfo/{timezone}", "/etc/localtime"], check=True)
            subprocess.run(["arch-chroot", "/mnt/higan-target", "hwclock", "--systohc"], check=True)

            self.current_pct = 80
            self.current_msg = "Generating kernel initramfs..."
            log("> Running mkinitcpio -P...")
            subprocess.run(["arch-chroot", "/mnt/higan-target", "mkinitcpio", "-P"], check=True)

            self.current_pct = 88
            self.current_msg = "Installing bootloader (Limine & GRUB)..."
            log("> Installing Limine & GRUB universal bootloader...")
            
            # Limine EFI installation
            try:
                os.makedirs("/mnt/higan-target/boot/efi/EFI/BOOT", exist_ok=True)
                os.makedirs("/mnt/higan-target/boot/limine", exist_ok=True)
                if os.path.exists("/usr/share/limine/BOOTX64.EFI"):
                    shutil.copy2("/usr/share/limine/BOOTX64.EFI", "/mnt/higan-target/boot/efi/EFI/BOOT/BOOTX64.EFI")
                
                # Render limine.conf with target UUID
                limine_cfg = f"""# Limine Bootloader - HiganveinOS
timeout: 5
interface_branding: H.V HiganveinOS
default_entry: 1

/HiganveinOS (Default)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux-cachyos
    kernel_cmdline: root=UUID={root_uuid} rw quiet loglevel=3 splash
    module_path: boot():/initramfs-linux-cachyos.img

/HiganveinOS (Fallback)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux-cachyos
    kernel_cmdline: root=UUID={root_uuid} rw
    module_path: boot():/initramfs-linux-cachyos-fallback.img
"""
                with open("/mnt/higan-target/boot/limine/limine.conf", "w") as lf:
                    lf.write(limine_cfg)
                with open("/mnt/higan-target/boot/efi/limine.conf", "w") as lf:
                    lf.write(limine_cfg)
                log("> Limine EFI bootloader deployed.")
            except Exception as e:
                log(f"> Note: Limine EFI deployment warning: {e}")

            # Also install GRUB as multi-OS / Windows chainloader fallback
            subprocess.run([
                "arch-chroot", "/mnt/higan-target", "grub-install",
                "--target=x86_64-efi", "--efi-directory=/boot/efi",
                "--bootloader-id=HiganveinOS", "--removable", "--recheck"
            ], check=True)

            if install_mode == "erase":
                subprocess.run([
                    "arch-chroot", "/mnt/higan-target", "grub-install",
                    "--target=i386-pc", "--recheck", disk
                ], stderr=subprocess.DEVNULL)
                subprocess.run(["limine", "bios-install", disk], stderr=subprocess.DEVNULL)

            grub_default = "/mnt/higan-target/etc/default/grub"
            if os.path.exists(grub_default):
                with open(grub_default, "a") as f:
                    f.write("\nGRUB_DISABLE_OS_PROBER=false\n")

            log("> Running grub-mkconfig (probing for other OSes)...")
            subprocess.run(["arch-chroot", "/mnt/higan-target", "grub-mkconfig", "-o", "/boot/grub/grub.cfg"], check=True)

            try:
                efiboot = subprocess.run(["efibootmgr"], capture_output=True, text=True).stdout
                h_num = None
                for line in efiboot.splitlines():
                    if "HiganveinOS" in line and line.startswith("Boot"):
                        h_num = line[4:8]
                        break
                if h_num:
                    for line in efiboot.splitlines():
                        if line.startswith("BootOrder:"):
                            curr = line.split("BootOrder:")[1].strip()
                            order = [h_num] + [n for n in curr.split(",") if n != h_num]
                            subprocess.run(["efibootmgr", "-o", ",".join(order)], check=True)
                            break
            except Exception:
                pass

            self.current_pct = 95
            self.current_msg = f"Creating user account '{username}'..."
            log(f"> Creating user '{username}' with sudo access...")
            subprocess.run(["arch-chroot", "/mnt/higan-target", "useradd", "-m", "-c", fullname, "-G", "wheel,audio,video,storage,power", username], check=True)
            subprocess.run(["arch-chroot", "/mnt/higan-target", "chpasswd"], input=f"{username}:{password}\nroot:root\n".encode(), check=True)
            with open("/mnt/higan-target/etc/sudoers.d/00-wheel-nopasswd", "w") as f:
                f.write("%wheel ALL=(ALL:ALL) NOPASSWD: ALL\n")

            if autologin:
                sddm_dir = "/mnt/higan-target/etc/sddm.conf.d"
                os.makedirs(sddm_dir, exist_ok=True)
                with open(f"{sddm_dir}/autologin.conf", "w") as sf:
                    sf.write(f"[Autologin]\nUser={username}\nSession=plasma\n")

            if os.path.exists("/mnt/higan-target/usr/local/bin/pacman"):
                os.remove("/mnt/higan-target/usr/local/bin/pacman")

            self.current_pct = 100
            self.current_msg = "Installation Completed Successfully!"
            log("> Installation complete.")
            self.finished.emit(True, "HiganveinOS has been installed successfully.")
        except Exception as e:
            err = str(e)
            log(f"> FATAL ERROR: {err}")
            self.finished.emit(False, err)

class HiganInstallerApp(QWidget):
    def __init__(self):
        super().__init__()
        self.initUI()

    def initUI(self):
        self.setWindowTitle("HiganveinOS Installer")
        self.setFixedSize(940, 620)
        self.setStyleSheet("""
            QWidget {
                background-color: #0f0f12;
                color: #f4f4f5;
                font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                font-size: 11pt;
            }
            QFrame#sidebar {
                background-color: #121216;
                border-right: 1px solid #1f1f24;
            }
            QLabel#brand_logo {
                font-family: 'JetBrains Mono', monospace;
                font-size: 22pt;
                font-weight: 900;
                color: #ef4444;
                letter-spacing: -1px;
            }
            QLabel#step_label {
                color: #71717a;
