            font-weight: bold;
            border: 2px solid #ef4444;
            border-radius: 40px;
            min-width: 80px;
            max-width: 80px;
            min-height: 80px;
            max-height: 80px;
        """)
        l.addWidget(check_circle, alignment=Qt.AlignmentFlag.AlignCenter)

        t = QLabel("Installation complete!")
        t.setStyleSheet("font-size: 20pt; font-weight: 800; color: #ffffff;")
        l.addWidget(t, alignment=Qt.AlignmentFlag.AlignCenter)

        desc = QLabel("HiganveinOS has been successfully installed.\nYou can now restart your computer and start using HiganveinOS.")
        desc.setStyleSheet("color: #a1a1aa; font-size: 11pt; text-align: center;")
        desc.setAlignment(Qt.AlignmentFlag.AlignCenter)
        l.addWidget(desc)

        l.addSpacing(10)
        self.chk_restart = QCheckBox("Restart now")
        self.chk_restart.setChecked(True)
        l.addWidget(self.chk_restart, alignment=Qt.AlignmentFlag.AlignCenter)

        self.stack.addWidget(page)

