#!/usr/bin/env bash
# HiganveinOS Modular Profile Installer (higan-bundle)
# Installs specialized stacks: gamer, dev, ricer, security

set -e

RED='\033[0;31m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
NC='\033[0m'

echo -e "${RED}"
echo "    O       /\\       O"
echo "    |      /  \\      |"
echo "    | *o* /    \\ *o* |"
echo "    |/__//      \\\\__|"
echo -e "${NC}"
echo -e "${WHITE}HiganveinOS Profile Bundle Manager${NC}"
echo -e "${GRAY}Modular software stack installer for gamers, developers, and ricers.${NC}\n"

if [[ $EUID -ne 0 ]]; then
   echo -e "${RED}[!] Jalankan perintah ini dengan sudo.${NC}" 
   exit 1
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo -e "${WHITE}Usage:${NC} sudo higan-bundle [--gamer] [--dev] [--ricer] [--cyber] [--nvidia] [--all]"
    echo ""
    echo -e "  ${RED}--gamer${NC}    Gaming stack (Steam, Lutris, Heroic, GameMode, Wine)"
    echo -e "  ${RED}--dev${NC}      Developer toolchain (VSCodium, GCC, Rust, Go, Docker)"
    echo -e "  ${RED}--ricer${NC}    Aesthetics & Hyprland suite (Waybar, Rofi, Serpentinum)"
    echo -e "  ${RED}--cyber${NC}    Offensive security & penetration testing arsenal"
    echo -e "  ${RED}--blackarch${NC} Add BlackArch Linux official repository (2800+ tools)"
    echo -e "  ${RED}--ai-agent${NC}  Agentic AI stack (Ollama, Hermes Agent, 9Router proxy/gateway)"
    echo -e "  ${RED}--nvidia${NC}   Official NVIDIA driver, 32-bit Vulkan libs & Settings GUI"
    echo -e "  ${RED}--all${NC}      Install all available standard bundles"
    echo ""
    exit 0
fi

enable_service() {
    local srv="$1"
    if command -v rc-update >/dev/null 2>&1; then
        rc-update add "$srv" default 2>/dev/null || true
        rc-service "$srv" start 2>/dev/null || true
    elif command -v systemctl >/dev/null 2>&1; then
        systemctl enable --now "$srv" 2>/dev/null || true
    fi
}

install_gamer() {
    echo -e "${RED}==>${NC} ${WHITE}Installing Gaming Stack (Steam, Heroic, ProtonUp, GameMode)...${NC}"
    pacman -S --needed --noconfirm steam lutris heroic-games-launcher protonup-qt mangohud gamemode gamescope wine-staging vulkan-tools lib32-mesa xpadneo-dkms
    
    echo -e "${GRAY}[+] Enabling gamemoded daemon...${NC}"
    enable_service gamemoded
    
    echo -e "${GRAY}[+] Setting kernel vm.max_map_count=1048576 (anti-crash for UE5/heavy games)...${NC}"
    mkdir -p /etc/sysctl.d
    echo "vm.max_map_count=1048576" > /etc/sysctl.d/99-higan-gaming.conf
    sysctl -w vm.max_map_count=1048576 2>/dev/null || true
    
    echo -e "${WHITE}[✓] Gaming Stack (Steam + Epic/GOG + Controller + Kernel Tweaks) installed.${NC}\n"
}

install_dev() {
    echo -e "${RED}==>${NC} ${WHITE}Installing Developer Toolchain & Compilers...${NC}"
    # Modern IDE, Neovim, Docker, CLI rust tools
    pacman -S --needed --noconfirm vscodium neovim git ripgrep fd bat eza fzf zoxide docker docker-compose
    
    # Core Compilers & Runtimes (C/C++, Rust, Go, Python, Node.js)
    echo -e "${RED}==>${NC} ${WHITE}Installing Core Compilers (GCC, Clang, Rust, Go, Python, Node.js)...${NC}"
    pacman -S --needed --noconfirm base-devel gcc clang make cmake rustup go python python-pip nodejs npm
    
    echo -e "${GRAY}[+] Enabling Docker daemon and adding $USER_NAME to docker group...${NC}"
    enable_service docker
    usermod -aG docker "$USER_NAME" 2>/dev/null || true
    echo -e "${WHITE}[✓] Developer & Compilers Stack installed successfully.${NC}\n"
}

install_ricer() {
    echo -e "${RED}==>${NC} ${WHITE}Installing Ricing Enthusiast Stack (Hyprland + Serpantinum Shell)...${NC}"
    echo -e "${GRAY}[i] Featured: Serpantinum Shell by Illia Miroshnichenko (ilyamiro)${NC}"
    echo -e "${GRAY}    Repository: https://github.com/ilyamiro/serpantinum${NC}"
    pacman -S --needed --noconfirm hyprland waybar rofi-wayland cava starship kitty zsh-syntax-highlighting zsh-autosuggestions hyprpaper waypaper mako grim slurp wl-clipboard hyprlock
    
    # Hide raw rofi launcher entries from KDE Kickoff to prevent 'Lost & Found' clutter
    for r_entry in /usr/share/applications/rofi.desktop /usr/share/applications/rofi-theme-selector.desktop; do
        if [ -f "$r_entry" ]; then
            if ! grep -q "NoDisplay=true" "$r_entry"; then
                echo "NoDisplay=true" >> "$r_entry"
            fi
        fi
    done
    
    echo -e "${GRAY}[+] Integrating Starship prompt to default shell...${NC}"
    if ! grep -q "starship init" /home/"$USER_NAME"/.bashrc 2>/dev/null; then
        echo 'eval "$(starship init bash)"' >> /home/"$USER_NAME"/.bashrc
    fi

    if [ -t 0 ]; then
        echo -e "\n${WHITE}Do you want to run the Serpantinum Shell automated installer now? [Y/n]${NC}"
        read -rp "Choice (default Y): " serp_choice
        if [[ ! "$serp_choice" =~ ^[Nn] ]]; then
            echo -e "${RED}==>${NC} ${WHITE}Launching Serpantinum Shell installer by ilyamiro...${NC}"
            su - "$USER_NAME" -c 'bash -c "$(curl -fsSL https://raw.githubusercontent.com/ilyamiro/serpantinum/master/install/install.sh)"' || true
        fi
    else
        echo -e "${GRAY}[i] To complete Serpantinum setup, run:${NC}"
        echo -e "${WHITE}    bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/ilyamiro/serpantinum/master/install/install.sh)\"${NC}"
    fi

    echo -e "${WHITE}[✓] Ricing Stack (Hyprland Suite + Serpantinum Shell) installed.${NC}\n"
}

install_cyber() {
    echo -e "${RED}==>${NC} ${WHITE}Installing Cybersecurity & Penetration Testing Arsenal...${NC}"
    echo -e "${GRAY}[i] Curated from Kali, ParrotOS & BlackArch core essentials${NC}"

    # Network, Sniffing & Spoofing
    echo -e "${GRAY}[+] Installing Network Recon & Traffic Analysis (Nmap, Wireshark, Bettercap, Masscan)...${NC}"
    pacman -S --needed --noconfirm nmap masscan wireshark-cli wireshark-qt tshark tcpdump termshark bettercap ettercap-gtk openbsd-netcat socat whois

    # Web Application Pentesting
    echo -e "${GRAY}[+] Installing Web & API Pentesting Suite (SQLmap, Gobuster, Nikto)...${NC}"
    pacman -S --needed --noconfirm sqlmap gobuster nikto

    # Password Cracking & Brute Force
    echo -e "${GRAY}[+] Installing Credential Recovery & Hash Cracking (Hydra, John, Hashcat)...${NC}"
    pacman -S --needed --noconfirm hydra john hashcat

    # Wireless & Radio
    echo -e "${GRAY}[+] Installing Wireless Security (Aircrack-ng)...${NC}"
    pacman -S --needed --noconfirm aircrack-ng

    # Reverse Engineering & Binary Exploitation
    echo -e "${GRAY}[+] Installing Reverse Engineering & Forensics (Ghidra, Radare2, GDB, Binwalk)...${NC}"
    pacman -S --needed --noconfirm radare2 gdb binwalk ghidra

    # Exploitation & Frameworks
    echo -e "${GRAY}[+] Installing Exploitation Frameworks & Databases (Metasploit, ExploitDB)...${NC}"
    pacman -S --needed --noconfirm metasploit exploitdb

    # Anonymity & OpSec (ParrotOS heritage)
    echo -e "${GRAY}[+] Installing OpSec & Anonymity Tools (Proxychains, Macchanger)...${NC}"
    pacman -S --needed --noconfirm proxychains-ng macchanger

    # User group permissions
    usermod -aG wireshark "$USER_NAME" 2>/dev/null || true

    echo -e "${WHITE}[✓] Cybersecurity Stack installed successfully.${NC}"
    echo -e "${GRAY}[i] Need 2800+ more specialized tools? Run: sudo higan-bundle --blackarch${NC}\n"
}

setup_blackarch() {
    echo -e "${RED}==>${NC} ${WHITE}Setting up BlackArch Linux Official Repository...${NC}"
    echo -e "${GRAY}[i] Adding signed repository with 2800+ cybersecurity tools directly to pacman${NC}"
    
    local strap_script
    strap_script=$(mktemp)
    if curl -fsSL https://blackarch.org/strap.sh -o "$strap_script"; then
        chmod +x "$strap_script"
        bash "$strap_script"
        rm -f "$strap_script"
        echo -e "${WHITE}[✓] BlackArch repository integrated successfully.${NC}"
        echo -e "${GRAY}[i] You can now install any tool with: pacman -S <tool-name>${NC}\n"
    else
        rm -f "$strap_script"
        echo -e "${RED}[!] Failed to download BlackArch strap.sh. Check internet connection.${NC}\n"
        return 1
    fi
}

install_ai_agent() {
    echo -e "${RED}==>${NC} ${WHITE}Installing Agentic AI Infrastructure (Ollama, Hermes Agent, 9Router)...${NC}"
    
    # 1. Base runtimes & dependencies
    echo -e "${GRAY}[+] Installing Core Runtimes (Ollama, Python uv, Node.js, SQLite3)...${NC}"
    pacman -S --needed --noconfirm ollama uv nodejs npm sqlite git

    # 2. Systemd service for Ollama (local offline LLM engine)
    echo -e "${GRAY}[+] Enabling and starting Ollama background daemon...${NC}"
    systemctl enable --now ollama.service 2>/dev/null || true

    # 3. 9Router - LLM Multi-Provider Gateway & Rate-Limit Router
    echo -e "${GRAY}[+] Installing 9Router via NPM global...${NC}"
    npm install -g 9router better-sqlite3

    # 4. Hermes Agent - Autonomous Agent Framework via uv isolated environment
    local user_home
    user_home=$(getent passwd "$USER_NAME" | cut -d: -f6)
    if [ -z "$user_home" ]; then
        user_home="/home/$USER_NAME"
    fi

    echo -e "${GRAY}[+] Setting up Hermes Agent environment for $USER_NAME...${NC}"
    su - "$USER_NAME" -c 'curl -fsSL https://raw.githubusercontent.com/NousResearch/Hermes-Agent/main/setup.sh | bash' || {
        echo -e "${GRAY}[i] Fallback: Provisioning Hermes Agent via uv tool/venv...${NC}"
        su - "$USER_NAME" -c 'uv tool install hermes-agent || uv venv ~/.hermes/hermes-agent/venv && ~/.hermes/hermes-agent/venv/bin/pip install hermes-agent' || true
    }

    # 5. Shell Helper Wrapper
    mkdir -p /usr/local/bin
    cat << 'EOF' > /usr/local/bin/higan-ai-status
#!/usr/bin/env bash
echo "=== HiganveinOS Agentic AI Status ==="
echo -n "Ollama Service: "
systemctl is-active ollama.service 2>/dev/null || echo "inactive"
echo -n "9Router Gateway: "
which 9router 2>/dev/null || echo "not found in PATH"
echo -n "Hermes Agent: "
which hermes 2>/dev/null || echo "check ~/.hermes or ~/.local/bin"
echo "====================================="
EOF
    chmod +x /usr/local/bin/higan-ai-status

    echo -e "${WHITE}[✓] Agentic AI Stack installed successfully.${NC}"
    echo -e "${GRAY}[i] Ollama active at: http://localhost:11434${NC}"
    echo -e "${GRAY}[i] Launch 9Router with: 9router${NC}"
    echo -e "${GRAY}[i] Launch Hermes Agent with: hermes${NC}\n"
}

install_nvidia() {
    echo -e "${RED}==>${NC} ${WHITE}Installing Official NVIDIA Proprietary / Open-Kernel Suite...${NC}"
    echo -e "${GRAY}[i] Installing kernel modules, 32-bit Wine gaming libraries, and NVIDIA Settings Control Panel...${NC}"
    pacman -S --needed --noconfirm linux-cachyos-nvidia-open nvidia-utils lib32-nvidia-utils nvidia-settings egl-wayland
    
    echo -e "${GRAY}[+] Configuring kernel DRM modesetting for Wayland (KDE / Hyprland)...${NC}"
    mkdir -p /etc/modprobe.d
    echo "options nvidia-drm modeset=1 fbdev=1" > /etc/modprobe.d/99-nvidia.conf
    
    echo -e "${GRAY}[+] Enabling NVIDIA systemd suspend/resume power services...${NC}"
    systemctl enable nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service 2>/dev/null || true
    
    echo -e "${WHITE}[✓] NVIDIA Gaming & Graphics Suite installed.${NC}"
    echo -e "${WHITE}    You can open 'NVIDIA X Server Settings' from your application menu or via command: nvidia-settings${NC}\n"
}

show_menu() {
    echo -e "${WHITE}Pilih bundle yang ingin di-install:${NC}"
    echo -e "  ${RED}1)${NC} Gamer Stack       ${GRAY}(Steam, Lutris, MangoHud, GameMode, Wine)${NC}"
    echo -e "  ${RED}2)${NC} Developer Stack   ${GRAY}(Neovim, Docker, eza, bat, ripgrep, fzf)${NC}"
    echo -e "  ${RED}3)${NC} Ricing Stack      ${GRAY}(Hyprland, Waybar, Cava, Starship, Rofi)${NC}"
    echo -e "  ${RED}4)${NC} Cyber Stack       ${GRAY}(Nmap, Wireshark, Metasploit, Ghidra, Hydra)${NC}"
    echo -e "  ${RED}5)${NC} BlackArch Repo    ${GRAY}(Tambahkan repo resmi BlackArch 2800+ tools)${NC}"
    echo -e "  ${RED}6)${NC} Agentic AI Stack  ${GRAY}(Ollama, Hermes Agent, 9Router Multi-Gateway)${NC}"
    echo -e "  ${RED}7)${NC} NVIDIA Suite      ${GRAY}(Driver Open-Kernel 615+, Vulkan, Control Panel)${NC}"
    echo -e "  ${RED}8)${NC} All Bundles       ${GRAY}(Install semua profil sekaligus)${NC}"
    echo -e "  ${RED}q)${NC} Keluar\n"
    read -rp "Pilihan Anda [1-8/q]: " choice
    case "$choice" in
        1) install_gamer ;;
        2) install_dev ;;
        3) install_ricer ;;
        4) install_cyber ;;
        5) setup_blackarch ;;
        6) install_ai_agent ;;
        7) install_nvidia ;;
        8) install_gamer; install_dev; install_ricer; install_cyber; install_ai_agent ;;
        q|Q) exit 0 ;;
        *) echo "Pilihan tidak valid."; exit 1 ;;
    esac
}

# CLI Flags support
if [ "$#" -eq 0 ]; then
    show_menu
else
    for arg in "$@"; do
        case "$arg" in
            --gamer) install_gamer ;;
            --dev) install_dev ;;
            --ricer) install_ricer ;;
            --cyber) install_cyber ;;
            --blackarch) setup_blackarch ;;
            --ai-agent) install_ai_agent ;;
            --nvidia) install_nvidia ;;
            --all) install_gamer; install_dev; install_ricer; install_cyber ;;
            *) echo "Unknown flag: $arg"; exit 1 ;;
        esac
    done
fi

echo -e "${WHITE}Proses selesai. Restart session jika diperlukan untuk memuat grup baru (docker/wireshark).${NC}"
