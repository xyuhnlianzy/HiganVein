#!/usr/bin/env python3
import sys, os, subprocess, shutil
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, 
    QStackedWidget, QComboBox, QLineEdit, QProgressBar, QMessageBox, QFrame, 
    QTextEdit, QCheckBox
)
from PyQt6.QtCore import Qt, QThread, pyqtSignal
from PyQt6.QtGui import QFont, QColor, QPalette

class InstallWorker(QThread):
    progress = pyqtSignal(int, str, str) # percent, status_msg, log_line
    finished = pyqtSignal(bool, str)

    def __init__(self, config):
        super().__init__()
        self.config = config

    def run(self):
        try:
            disk = self.config['disk']
            fs = self.config['fs']
            username = self.config['username']
            password = self.config['password']
            hostname = self.config['hostname']
            timezone = self.config['timezone']
            keyboard = self.config['keyboard']

            def log(msg):
                print(msg)
                self.progress.emit(self.current_pct, self.current_msg, msg)

            self.current_pct = 10
            self.current_msg = f"Memformat disk {disk}..."
            log(f"Starting installation on {disk} with filesystem {fs}...")

            # Partitioning
            subprocess.run(["sgdisk", "--zap-all", disk], check=True)
            subprocess.run(["parted", "-s", disk, "mklabel", "gpt"], check=True)
            subprocess.run(["parted", "-s", disk, "mkpart", "esp", "fat32", "1MiB", "512MiB"], check=True)
            subprocess.run(["parted", "-s", disk, "set", "1", "esp", "on"], check=True)
            subprocess.run(["parted", "-s", disk, "mkpart", "root", fs, "512MiB", "100%"], check=True)

            if "nvme" in disk or "loop" in disk or "mmcblk" in disk:
                esp_part = f"{disk}p1"
                root_part = f"{disk}p2"
            else:
                esp_part = f"{disk}1"
                root_part = f"{disk}2"

            self.current_pct = 25
            self.current_msg = "Memformat filesystem (FAT32 & " + fs.upper() + ")..."
            log(format(f"Formatting ESP ({esp_part}) to FAT32..."))
            subprocess.run(["mkfs.fat", "-F32", esp_part], check=True)
            
            log(f"Formatting Root ({root_part}) to {fs}...")
            if fs == "btrfs":
                subprocess.run(["mkfs.btrfs", "-f", root_part], check=True)
            else:
                subprocess.run(["mkfs.ext4", "-F", root_part], check=True)

            self.current_pct = 40
            self.current_msg = "Mounting target filesystems..."
            os.makedirs("/mnt/higan-target", exist_ok=True)
            subprocess.run(["mount", root_part, "/mnt/higan-target"], check=True)
            os.makedirs("/mnt/higan-target/boot/efi", exist_ok=True)
            subprocess.run(["mount", esp_part, "/mnt/higan-target/boot/efi"], check=True)

            self.current_pct = 50
            self.current_msg = "Menyalin sistem HiganveinOS (rsync)..."
            log("Copying live system root to target via rsync...")
            subprocess.run([
                "rsync", "-aAXH", 
                "--exclude=/dev/*", "--exclude=/proc/*", "--exclude=/sys/*", 
                "--exclude=/run/*", "--exclude=/tmp/*", "--exclude=/mnt/*",
                "--exclude=/mnt/higan-target/*", "--exclude=/lost+found",
                "/", "/mnt/higan-target/"
            ], check=True)

            self.current_pct = 70
            self.current_msg = "Konfigurasi FSTAB & Locale..."
            # fstab
            with open("/mnt/higan-target/etc/fstab", "w") as f:
                root_uuid = subprocess.run(["blkid", "-s", "UUID", "-o", "value", root_part], capture_output=True, text=True).stdout.strip()
                esp_uuid = subprocess.run(["blkid", "-s", "UUID", "-o", "value", esp_part], capture_output=True, text=True).stdout.strip()
                f.write(f"# HiganveinOS Fstab Generated by Native Installer\n")
                f.write(f"UUID={root_uuid} / {fs} defaults 0 1\n")
                f.write(f"UUID={esp_uuid} /boot/efi vfat umask=0077 0 2\n")

            # Hostname & Timezone
            with open("/mnt/higan-target/etc/hostname", "w") as f:
                f.write(hostname + "\n")
            
            subprocess.run(["arch-chroot", "/mnt/higan-target", "ln", "-sf", f"/usr/share/zoneinfo/{timezone}", "/etc/localtime"], check=True)
            subprocess.run(["arch-chroot", "/mnt/higan-target", "hwclock", "--systohc"], check=True)

            self.current_pct = 85
            self.current_msg = "Install Bootloader (GRUB) & User..."
            subprocess.run(["arch-chroot", "/mnt/higan-target", "grub-install", "--target=x86_64-efi", "--efi-directory=/boot/efi", "--bootloader-id=HiganveinOS", "--recheck"], check=True)
            subprocess.run(["arch-chroot", "/mnt/higan-target", "grub-mkconfig", "-o", "/boot/grub/grub.cfg"], check=True)

            # User setup
            subprocess.run(["arch-chroot", "/mnt/higan-target", "useradd", "-m", "-G", "wheel,audio,video,storage,power", username], check=True)
            subprocess.run(["arch-chroot", "/mnt/higan-target", "chpasswd"], input=f"{username}:{password}\nroot:root\n".encode(), check=True)
            
            # Sudoers wheel
            with open("/mnt/higan-target/etc/sudoers.d/00-wheel-nopasswd", "w") as f:
                f.write("%wheel ALL=(ALL:ALL) NOPASSWD: ALL\n")

            self.current_pct = 100
            self.current_msg = "Instalasi Selesai!"
            log("HiganveinOS installation completed successfully!")
            self.finished.emit(True, "HiganveinOS berhasil diinstal!")
        except Exception as e:
            import traceback
            traceback.print_exc()
            self.finished.emit(False, str(e))

class HiganInstallerApp(QWidget):
    def __init__(self):
        super().__init__()
        self.config = {}
        self.init_ui()

    def init_ui(self):
        self.setWindowTitle("HiganveinOS Advanced Native Installer")
        self.setFixedSize(750, 560)
        self.setStyleSheet("""
            QWidget {
                background-color: #0c0c0e;
                color: #f4f4f5;
                font-family: 'Segoe UI', sans-serif;
                font-size: 13px;
            }
            QLabel#title {
                font-size: 20px;
                font-weight: 800;
                color: #ef4444;
            }
            QLabel#subtitle {
                font-size: 13px;
                color: #a1a1aa;
            }
            QFrame#card {
                background-color: #18181b;
                border: 1px solid #27272a;
                border-radius: 12px;
                padding: 16px;
            }
            QPushButton {
                background-color: #dc2626;
                color: white;
                font-weight: 700;
                padding: 10px 20px;
                border-radius: 6px;
                border: none;
            }
            QPushButton:hover {
                background-color: #b91c1c;
            }
            QPushButton#secondary {
                background-color: #27272a;
                color: #f4f4f5;
            }
            QPushButton#secondary:hover {
                background-color: #3f3f46;
            }
            QLineEdit, QComboBox {
                background-color: #27272a;
                color: white;
                border: 1px solid #3f3f46;
                padding: 8px;
                border-radius: 6px;
            }
            QTextEdit {
                background-color: #121214;
                color: #22c55e;
                border: 1px solid #27272a;
                font-family: monospace;
                border-radius: 6px;
            }
        """)

        main_layout = QVBoxLayout()
        main_layout.setContentsMargins(30, 30, 30, 30)
        main_layout.setSpacing(20)

        # Header Title
        self.title_label = QLabel("HiganveinOS Setup Wizard")
        self.title_label.setObjectName("title")
        main_layout.addWidget(self.title_label)

        self.stack = QStackedWidget()

        # Page 1: Welcome
        page1 = QWidget()
        p1_l = QVBoxLayout(page1)
        p1_l.setSpacing(15)
        p1_l.addWidget(QLabel("Selamat datang di HiganveinOS Installer!"))
        p1_l.addWidget(QLabel("Distribusi Linux kustom berbasis Arch dengan CachyOS Kernel, Hyprland, dan estetika Dark Void."))
        p1_l.addStretch()
        btn1 = QPushButton("Lanjutkan Instalasi")
        btn1.clicked.connect(lambda: self.stack.setCurrentIndex(1))
        p1_l.addWidget(btn1, alignment=Qt.AlignmentFlag.AlignRight)
        self.stack.addWidget(page1)

        # Page 2: Locale & Keyboard
        page2 = QWidget()
        p2_l = QVBoxLayout(page2)
        p2_l.setSpacing(15)
        p2_l.addWidget(QLabel("Zona Waktu & Keyboard Layout:"))
        
        p2_l.addWidget(QLabel("Zona Waktu:"))
        self.tz_combo = QComboBox()
        self.tz_combo.addItems(["Asia/Jakarta", "Asia/Makassar", "Asia/Jayapura", "UTC", "America/New_York", "Europe/London"])
        p2_l.addWidget(self.tz_combo)

        p2_l.addWidget(QLabel("Keyboard Layout:"))
        self.kb_combo = QComboBox()
        self.kb_combo.addItems(["us", "id", "uk", "de", "fr"])
        p2_l.addWidget(self.kb_combo)

        p2_l.addStretch()
        h_box2 = QHBoxLayout()
        back2 = QPushButton("Kembali"); back2.setObjectName("secondary")
        back2.clicked.connect(lambda: self.stack.setCurrentIndex(0))
        next2 = QPushButton("Berikutnya")
        next2.clicked.connect(lambda: self.stack.setCurrentIndex(2))
        h_box2.addWidget(back2)
        h_box2.addWidget(next2)
        p2_l.addLayout(h_box2)
        self.stack.addWidget(page2)

        # Page 3: Partitioning & Disk
        page3 = QWidget()
        p3_l = QVBoxLayout(page3)
        p3_l.setSpacing(15)
        p3_l.addWidget(QLabel("Pilih Disk & Filesystem:"))
        
        p3_l.addWidget(QLabel("Target Disk:"))
        self.disk_combo = QComboBox()
        disks = [f"/dev/{d}" for d in os.listdir("/sys/block") if d.startswith("sd") or d.startswith("nvme") or d.startswith("vd")]
        if not disks:
            disks = ["/dev/sda"]
        self.disk_combo.addItems(disks)
        p3_l.addWidget(self.disk_combo)

        p3_l.addWidget(QLabel("Filesystem Root:"))
        self.fs_combo = QComboBox()
        self.fs_combo.addItems(["ext4", "btrfs"])
        p3_l.addWidget(self.fs_combo)

        p3_l.addWidget(QLabel("<font color='#ef4444'>Perhatian: Seluruh data pada disk yang dipilih akan dihapus dan diformat otomatis!</font>"))
        p3_l.addStretch()

        h_box3 = QHBoxLayout()
        back3 = QPushButton("Kembali"); back3.setObjectName("secondary")
        back3.clicked.connect(lambda: self.stack.setCurrentIndex(1))
        next3 = QPushButton("Berikutnya")
        next3.clicked.connect(lambda: self.stack.setCurrentIndex(3))
        h_box3.addWidget(back3)
        h_box3.addWidget(next3)
        p3_l.addLayout(h_box3)
        self.stack.addWidget(page3)

        # Page 4: User & Hostname
        page4 = QWidget()
        p4_l = QVBoxLayout(page4)
        p4_l.setSpacing(12)
        p4_l.addWidget(QLabel("Konfigurasi Akun Pengguna & Hostname:"))

        p4_l.addWidget(QLabel("Hostname (Nama Komputer):"))
        self.host_input = QLineEdit("higanveinos")
        p4_l.addWidget(self.host_input)

        p4_l.addWidget(QLabel("Username:"))
        self.user_input = QLineEdit("higan")
        p4_l.addWidget(self.user_input)

        p4_l.addWidget(QLabel("Password:"))
        self.pass_input = QLineEdit()
        self.pass_input.setEchoMode(QLineEdit.EchoMode.Password)
        p4_l.addWidget(self.pass_input)

        p4_l.addStretch()
        h_box4 = QHBoxLayout()
        back4 = QPushButton("Kembali"); back4.setObjectName("secondary")
        back4.clicked.connect(lambda: self.stack.setCurrentIndex(2))
        next4 = QPushButton("Tinjau Ringkasan")
        next4.clicked.connect(self.prepare_summary)
        h_box4.addWidget(back4)
        h_box4.addWidget(next4)
        p4_l.addLayout(h_box4)
        self.stack.addWidget(page4)

        # Page 5: Summary
        page5 = QWidget()
        p5_l = QVBoxLayout(page5)
        p5_l.setSpacing(15)
        p5_l.addWidget(QLabel("Ringkasan Instalasi:"))
        self.summary_text = QLabel("Loading...")
        self.summary_text.setStyleSheet("background-color: #18181b; padding: 12px; border-radius: 6px; border: 1px solid #27272a;")
        p5_l.addWidget(self.summary_text)
        p5_l.addStretch()

        h_box5 = QHBoxLayout()
        back5 = QPushButton("Kembali"); back5.setObjectName("secondary")
        back5.clicked.connect(lambda: self.stack.setCurrentIndex(3))
        self.install_btn = QPushButton("Mulai Instalasi Sekarang")
        self.install_btn.clicked.connect(self.start_installation)
        h_box5.addWidget(back5)
        h_box5.addWidget(self.install_btn)
        p5_l.addLayout(h_box5)
        self.stack.addWidget(page5)

        # Page 6: Progress & Live Log
        page6 = QWidget()
        p6_l = QVBoxLayout(page6)
        p6_l.setSpacing(12)
        self.status_label = QLabel("Memulai proses instalasi...")
        p6_l.addWidget(self.status_label)
        self.progress_bar = QProgressBar()
        self.progress_bar.setValue(0)
        p6_l.addWidget(self.progress_bar)
        
        p6_l.addWidget(QLabel("Log Proses:"))
        self.log_box = QTextEdit()
        self.log_box.setReadOnly(True)
        p6_l.addWidget(self.log_box)
        self.stack.addWidget(page6)

        main_layout.addWidget(self.stack)
        self.setLayout(main_layout)

    def prepare_summary(self):
        user = self.user_input.text().strip()
        pwd = self.pass_input.text().strip()
        if not user or not pwd:
            QMessageBox.warning(self, "Error", "Username dan password wajib diisi!")
            return
        
        summary = f"""• Target Disk : {self.disk_combo.currentText()}
• Filesystem  : {self.fs_combo.currentText()}
• Zona Waktu  : {self.tz_combo.currentText()}
• Keyboard    : {self.kb_combo.currentText()}
• Hostname    : {self.host_input.text()}
• Username    : {user}
• Bootloader  : GRUB EFI (UEFI)"""
        self.summary_text.setText(summary)
        self.stack.setCurrentIndex(4)

    def start_installation(self):
        self.config = {
            'disk': self.disk_combo.currentText(),
            'fs': self.fs_combo.currentText(),
            'timezone': self.tz_combo.currentText(),
            'keyboard': self.kb_combo.currentText(),
            'hostname': self.host_input.text().strip() or "higanveinos",
            'username': self.user_input.text().strip(),
            'password': self.pass_input.text().strip()
        }
        self.stack.setCurrentIndex(5)
        self.worker = InstallWorker(self.config)
        self.worker.progress.connect(self.update_progress)
        self.worker.finished.connect(self.installation_finished)
        self.worker.start()

    def update_progress(self, val, msg, log_line):
        self.progress_bar.setValue(val)
        self.status_label.setText(msg)
        self.log_box.append(log_line)

    def installation_finished(self, success, msg):
        if success:
            QMessageBox.information(self, "Sukses", msg + "\nSistem siap direstart!")
            sys.exit(0)
        else:
            QMessageBox.critical(self, "Gagal", f"Instalasi gagal: {msg}")
            self.stack.setCurrentIndex(0)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = HiganInstallerApp()
    window.show()
    sys.exit(app.exec())
