                color: #d4d4d8;
                spacing: 8px;
            }
            QTextEdit {
                background-color: #121215;
                border: 1px solid #1f1f24;
                border-radius: 6px;
                color: #a1a1aa;
                font-family: 'JetBrains Mono', monospace;
                font-size: 9pt;
            }
            QListWidget {
                background-color: #16161a;
                border: 1px solid #27272a;
                border-radius: 6px;
                padding: 4px;
            }
            QListWidget::item {
                padding: 6px 10px;
                border-radius: 4px;
            }
            QListWidget::item:selected {
                background-color: #991b1b;
                color: #ffffff;
                font-weight: 600;
            }
        """)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        # 1. Left Sidebar
        sidebar = QFrame()
        sidebar.setObjectName("sidebar")
        sidebar.setFixedWidth(200)
        sb_layout = QVBoxLayout(sidebar)
        sb_layout.setContentsMargins(18, 24, 18, 24)
        sb_layout.setSpacing(6)

        logo = QLabel("H.V")
        logo.setObjectName("brand_logo")
        sb_layout.addWidget(logo)

        sub_brand = QLabel("<small style='color: #52525b; font-size: 8pt; font-weight: bold; letter-spacing: 1px;'>HIGANVEIN</small>")
        sb_layout.addWidget(sub_brand)
        sb_layout.addSpacing(16)

        self.step_names = [
            "Welcome", "Location", "Keyboard", "Partitioning",
            "Users", "Summary", "Install", "Finish"
        ]
        self.step_widgets = []
        for name in self.step_names:
            lbl = QLabel(name)
            lbl.setObjectName("step_label")
            self.step_widgets.append(lbl)
            sb_layout.addWidget(lbl)

        sb_layout.addStretch()

        about_links = QLabel("<small><a href='#' style='color: #71717a; text-decoration: none;'>About</a> &nbsp;•&nbsp; <a href='#' style='color: #71717a; text-decoration: none;'>Support</a></small>")
        sb_layout.addWidget(about_links)
        layout.addWidget(sidebar)

        # 2. Main Content
        content_container = QFrame()
        cc_layout = QVBoxLayout(content_container)
        cc_layout.setContentsMargins(36, 28, 36, 24)

        self.stack = QStackedWidget()
        cc_layout.addWidget(self.stack)

        # Bottom Controls
        bottom_bar = QHBoxLayout()
        bottom_bar.setContentsMargins(0, 10, 0, 0)
        self.btn_back = QPushButton("Back")
        self.btn_back.setObjectName("btn_secondary")
        self.btn_back.clicked.connect(self.go_back)

        self.btn_next = QPushButton("Next")
        self.btn_next.clicked.connect(self.go_next)

        bottom_bar.addStretch()
        bottom_bar.addWidget(self.btn_back)
        bottom_bar.addWidget(self.btn_next)
        cc_layout.addLayout(bottom_bar)

        layout.addWidget(content_container)

        # Build 8 Pages
        self.init_page_welcome()
        self.init_page_location()
        self.init_page_keyboard()
        self.init_page_partitioning()
        self.init_page_users()
        self.init_page_summary()
        self.init_page_install()
        self.init_page_finish()

        self.set_step(0)

    def set_step(self, idx):
        self.stack.setCurrentIndex(idx)
        for i, lbl in enumerate(self.step_widgets):
            lbl.setObjectName("step_label_active" if i == idx else "step_label")
            lbl.style().unpolish(lbl)
            lbl.style().polish(lbl)

        self.btn_back.setEnabled(idx > 0 and idx not in (6, 7))
        self.btn_back.setVisible(idx != 7)

        if idx == 5:
            self.btn_next.setText("Install")
            self.btn_next.setEnabled(True)
        elif idx == 6:
            self.btn_next.setText("Installing...")
            self.btn_next.setEnabled(False)
        elif idx == 7:
            self.btn_next.setText("Done")
            self.btn_next.setEnabled(True)
        else:
            self.btn_next.setText("Next")
            self.btn_next.setEnabled(True)

    def go_back(self):
        curr = self.stack.currentIndex()
        if curr > 0 and curr not in (6, 7):
            self.set_step(curr - 1)

    def go_next(self):
        curr = self.stack.currentIndex()
        if curr == 5:
            self.start_installation()
        elif curr == 7:
            if self.chk_restart.isChecked():
                subprocess.run(["reboot"])
            self.close()
        elif curr < 5:
            if curr == 4:
                self.update_summary()
            self.set_step(curr + 1)

    # ---------------- PAGE 1: WELCOME ----------------
    def init_page_welcome(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(14)

        t = QLabel("Welcome to HiganveinOS")
        t.setStyleSheet("font-size: 20pt; font-weight: 800; color: #ffffff;")
        l.addWidget(t)

        st = QLabel("A lightweight, modern Arch-based Linux distribution built for performance and simplicity.")
        st.setStyleSheet("color: #a1a1aa; font-size: 11pt;")
        l.addWidget(st)

        l.addSpacing(6)
        spec_badge = QLabel("Arch Linux &nbsp;•&nbsp; CachyOS Kernel &nbsp;•&nbsp; KDE Plasma")
        spec_badge.setStyleSheet("color: #71717a; font-weight: 600; font-size: 9pt;")
        l.addWidget(spec_badge)

        quote_box = QFrame()
        quote_box.setStyleSheet("background-color: #141417; border-left: 3px solid #ef4444; border-radius: 4px; padding: 12px 16px;")
        ql = QVBoxLayout(quote_box)
        q_txt = QLabel("<i>“A quiet system for a clearer mind.”</i>")
        q_txt.setStyleSheet("color: #d4d4d8; font-size: 10pt;")
        ql.addWidget(q_txt)
        l.addWidget(quote_box)

        l.addSpacing(10)
        l.addWidget(QLabel("Select Installer Language:"))
        self.combo_lang = QComboBox()
        self.combo_lang.addItems(["English (United States)", "Indonesian (Bahasa Indonesia)"])
        l.addWidget(self.combo_lang)

        l.addStretch()
        self.stack.addWidget(page)

    # ---------------- PAGE 2: LOCATION ----------------
    def init_page_location(self):
        page = QWidget()
        l = QVBoxLayout(page)
        l.setSpacing(14)

        t = QLabel("Location")
        t.setStyleSheet("font-size: 20pt; font-weight: 800; color: #ffffff;")
        l.addWidget(t)

        st = QLabel("Select your location to set the time zone and regional settings.")
        st.setStyleSheet("color: #a1a1aa; font-size: 11pt;")
        l.addWidget(st)

        map_card = QFrame()
        map_card.setStyleSheet("background-color: #141417; border: 1px solid #27272a; border-radius: 8px; padding: 20px;")
        ml = QVBoxLayout(map_card)
        ml.setSpacing(8)
        self.lbl_selected_tz = QLabel("📍 <b>Selected Timezone:</b> Asia/Jakarta")
        self.lbl_selected_tz.setStyleSheet("color: #ef4444; font-size: 12pt; font-weight: bold;")
        ml.addWidget(self.lbl_selected_tz)
        map_desc = QLabel("Automatic network time synchronization (systemd-timesyncd) is enabled.")
        map_desc.setStyleSheet("color: #71717a; font-size: 9pt;")
        ml.addWidget(map_desc)
        l.addWidget(map_card)

        row = QHBoxLayout()
        col1 = QVBoxLayout()
        col1.addWidget(QLabel("Region / Continent:"))
        self.combo_region = QComboBox()
        col1.addWidget(self.combo_region)
        row.addLayout(col1, stretch=1)

        col2 = QVBoxLayout()
        col2.addWidget(QLabel("Zone / City:"))
        self.combo_zone = QComboBox()
        col2.addWidget(self.combo_zone)
        row.addLayout(col2, stretch=2)
        l.addLayout(row)

        self.populate_timezones()
        self.combo_region.currentTextChanged.connect(self.on_region_changed)
        self.combo_zone.currentTextChanged.connect(self.on_zone_changed)

        l.addStretch()
        self.stack.addWidget(page)

    def populate_timezones(self):
        self.tz_data = {}
        base = "/usr/share/zoneinfo"
        if os.path.exists(base):
            for reg in sorted(os.listdir(base)):
                reg_path = os.path.join(base, reg)
                if os.path.isdir(reg_path) and reg not in ("posix", "right", "SystemV"):
                    cities = []
                    for root, _, files in os.walk(reg_path):
                        for f in files:
                            if not f.endswith(".tab") and not f.endswith(".list"):
                                rel = os.path.relpath(os.path.join(root, f), reg_path)
                                cities.append(rel)
                    if cities:
                        self.tz_data[reg] = sorted(cities)

        if not self.tz_data:
            self.tz_data = {"Asia": ["Jakarta", "Makassar", "Jayapura", "Singapore", "Tokyo"]}

        self.combo_region.addItems(sorted(self.tz_data.keys()))
        if "Asia" in self.tz_data:
            self.combo_region.setCurrentText("Asia")
        self.on_region_changed(self.combo_region.currentText())

        # Auto select Jakarta if available
        if "Asia" in self.tz_data and "Jakarta" in self.tz_data["Asia"]:
            self.combo_zone.setCurrentText("Jakarta")

    def on_region_changed(self, region):
        self.combo_zone.clear()
        cities = self.tz_data.get(region, [])
        self.combo_zone.addItems(cities)
        self.on_zone_changed(self.combo_zone.currentText())

    def on_zone_changed(self, zone):
        reg = self.combo_region.currentText()
        if reg and zone:
            self.lbl_selected_tz.setText(f"📍 <b>Selected Timezone:</b> {reg}/{zone}")

