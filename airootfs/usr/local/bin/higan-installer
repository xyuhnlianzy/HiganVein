    def populate_disks(self):
        self.combo_disk.clear()
        live = get_live_boot_device()
        disks = []
        for d in os.listdir("/sys/block"):
            if d.startswith("sd") or d.startswith("nvme") or d.startswith("vd"):
                dev_path = f"/dev/{d}"
                if live and dev_path == live:
                    continue
                try:
                    with open(f"/sys/block/{d}/ro", "r") as rf:
                        if rf.read().strip() == "0":
                            with open(f"/sys/block/{d}/size", "r") as sf:
                                gb = round((int(sf.read().strip()) * 512) / (1024**3), 1)
                            model = ""
                            try:
                                with open(f"/sys/block/{d}/device/model", "r") as mf:
                                    model = mf.read().strip()
                            except Exception:
                                pass
                            dtype = "NVMe" if "nvme" in d else "SATA"
                            label = f"{dev_path} — {dtype} {gb} GB"
                            if model:
                                label += f" ({model})"
                            disks.append(label)
                except Exception:
                    pass
        if not disks:
            disks = ["/dev/sda (Drive Default)"]
        self.combo_disk.addItems(disks)

