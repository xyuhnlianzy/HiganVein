        ib_l.addWidget(QLabel("• <b>Desktop:</b> KDE Plasma on Wayland/X11, ZRAM 2× RAM compression, earlyoom daemon"))
        ib_l.addWidget(QLabel("• <b>Multi-Boot:</b> GRUB UEFI & Legacy BIOS support, automated Windows/Linux detection"))
        ib_l.addWidget(QLabel("• <b>Windows Layer:</b> Out-of-the-box Wine execution and 32/64-bit Vulkan graphics drivers"))
